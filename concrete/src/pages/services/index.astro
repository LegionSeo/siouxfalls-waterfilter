---
import Layout from '../../layouts/Layout.astro';
import Photo from '../../components/Photo.astro';
import CtaBand from '../../components/CtaBand.astro';
import Crumbs from '../../components/Crumbs.astro';
import { SITE } from '../../config/site';
import { SERVICES } from '../../content/services';
import { breadcrumbNode } from '../../lib/schema';
const crumbs = [{ name: 'Home', path: '/' }, { name: 'Services', path: '/services' }];
const graph = [
  breadcrumbNode(crumbs),
  {
    '@type': 'ItemList',
    name: 'Concrete services in Sioux Falls',
    itemListElement: SERVICES.map((s, i) => ({ '@type': 'ListItem', position: i + 1, name: s.name, url: `${SITE.origin}/services/${s.slug}` })),
  },
];
---
<Layout
  title="Concrete Services in Sioux Falls, SD | Sioux Falls Concrete"
  description="All concrete services in Sioux Falls, SD: driveways, patios, sidewalks, garage floors, stamped concrete, foundations, repair, and commercial flatwork."
  graph={graph}
>
  <section class="wrap pb-10 pt-6">
    <Crumbs items={crumbs} />
    <h1 class="mt-8 max-w-[18ch]">Concrete services in Sioux Falls</h1>
    <p class="lede mt-6 measure">Pick the job closest to yours. Each page covers what is included and the local rules that apply.</p>
  </section>
  <div class="wrap"><div class="joint-rule" aria-hidden="true"></div></div>
  <section class="band-tight">
    <ul class="wrap grid gap-x-10 gap-y-12 md:grid-cols-2">
      {SERVICES.map((s) => (
        <li>
          <a href={`/services/${s.slug}`} class="group grid grid-cols-[7.5rem_1fr] items-start gap-5 no-underline sm:grid-cols-[10rem_1fr]">
            <div class="aspect-square overflow-hidden rounded-md bg-paper">
              {s.photo ? (
                <Photo name={s.photo} ratio={1} sizes="10rem" widths={[240, 400]} />
              ) : (
                <svg viewBox="0 0 100 100" class="h-full w-full" aria-hidden="true"><rect width="100" height="100" fill="#d6d3cc"/><path d="M0 50h100M50 0v100" stroke="#ecebe7" stroke-width="3"/><path d="M8 8h34v34H8zM58 58h34v34H58z" fill="none" stroke="#a33b46" stroke-width="1.5" stroke-dasharray="4 4"/></svg>
              )}
            </div>
            <div>
              <h2 class="text-[1.4rem] group-hover:text-quartz-deep">{s.name}</h2>
              <p class="mt-2 text-steel">{s.summary}</p>
              <span class="mt-3 inline-block text-sm font-semibold text-quartz-deep underline underline-offset-4">Read about {s.short.toLowerCase()}</span>
            </div>
          </a>
        </li>
      ))}
    </ul>
  </section>
  <CtaBand />
</Layout>
