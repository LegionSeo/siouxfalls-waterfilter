---
import Layout from '../layouts/Layout.astro';
import Photo from '../components/Photo.astro';
import Faq from '../components/Faq.astro';
import CtaBand from '../components/CtaBand.astro';
import SlabSection from '../components/SlabSection.astro';
import Source from '../components/Source.astro';
import { SITE } from '../config/site';
import { SERVICES } from '../content/services';
import { TOWNS, ALSO_SERVED } from '../content/towns';
import { PHOTOS, photoUrl } from '../content/photos';
import { faqNode, breadcrumbNode } from '../lib/schema';

const featured = ['concrete-driveways', 'concrete-patios', 'sidewalks'].map((slug) => SERVICES.find((s) => s.slug === slug)!);
const rest = SERVICES.filter((s) => !featured.includes(s));

const faqs = [
  {
    q: 'Do I need a permit to replace a sidewalk in Sioux Falls?',
    a: 'Yes. The City of Sioux Falls says you need a permit before repairing, replacing, or installing a sidewalk. A paid crew has to be bonded and insured with the City. We get the permit as part of the job.',
  },
  {
    q: 'Who pays to fix the sidewalk in front of my house?',
    a: 'In Sioux Falls the property owner pays for sidewalk repair. Pedestrian ramps and the corner panel at an intersection are the City’s job.',
  },
  {
    q: 'How much does concrete work cost?',
    a: 'Price depends on the size, the thickness, whether old concrete comes out, the finish, and how close the truck can get. We measure first, then give you one price for the job.',
  },
  {
    q: 'Can you pour concrete when it is cold?',
    a: 'Yes, with care. Fresh concrete has to be kept from freezing until it gains early strength, so cold weather pours need blankets or heat. That can add cost, and we will tell you up front.',
  },
  {
    q: 'What towns do you work in?',
    a: `Sioux Falls, plus ${TOWNS.map((t) => t.name).join(', ')}. We also take jobs in ${ALSO_SERVED.slice(0, -1).join(', ')}, and ${ALSO_SERVED.at(-1)}.`,
  },
  {
    q: 'How do I get a quote?',
    a: `Call ${SITE.phoneDisplay}. Tell us the job, the address, and a rough size. We will set a time to come measure.`,
  },
];

const hero = PHOTOS.chutePour;
const heroWidths = [600, 900, 1300];
const heroRatio = 4 / 5;
const heroSrcset = heroWidths.map((w) => `${photoUrl(hero.id, w, Math.round(w / heroRatio))} ${w}w`).join(', ');
const heroSizes = '(min-width: 1024px) 40vw, 100vw';

const graph = [faqNode(faqs), breadcrumbNode([{ name: 'Home', path: '/' }])];
---

<Layout
  title="Concrete Contractors in Sioux Falls, SD | Sioux Falls Concrete"
  description="Concrete contractors in Sioux Falls, SD for driveways, patios, sidewalks, garage floors, stamped concrete, and repairs. City sidewalk permits handled. Call for a quote."
  graph={graph}
  preloadImage={{ src: photoUrl(hero.id, 900, Math.round(900 / heroRatio)), srcset: heroSrcset, sizes: heroSizes }}
>
  <!-- Hero -->
  <section class="relative overflow-hidden">
    <div class="wrap grid items-center gap-10 pb-14 pt-10 lg:grid-cols-[1.15fr_0.85fr] lg:gap-14 lg:pb-20 lg:pt-16">
      <div>
        <p class="text-[0.95rem] font-semibold text-quartz-deep">Sioux Falls, South Dakota</p>
        <h1 class="mt-3">Concrete contractors in Sioux Falls</h1>
        <p class="lede mt-6 measure">Driveways, patios, sidewalks, and garage floors, poured to stand up to South Dakota winters. We also fix the concrete you already have.</p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href={SITE.phoneHref} class="btn btn-call btn-big" data-call="hero">Call {SITE.phoneDisplay}</a>
          <a href="/services" class="btn btn-plain btn-big">See all services</a>
        </div>
        <ul class="mt-10 grid max-w-xl gap-x-8 gap-y-3 border-t border-line pt-6 text-[0.98rem] sm:grid-cols-2">
          <li><strong class="font-bold">Homes and businesses</strong><br /><span class="text-steel">Flatwork, slabs, and footings</span></li>
          <li><strong class="font-bold">City sidewalk notices</strong><br /><span class="text-steel">Permit pulled as part of the job</span></li>
        </ul>
      </div>
      <div class="relative">
        <div class="aspect-[4/5] overflow-hidden rounded-md lg:-mr-10">
          <img
            src={photoUrl(hero.id, 900, Math.round(900 / heroRatio))}
            srcset={heroSrcset}
            sizes={heroSizes}
            width="900"
            height="1125"
            alt={hero.alt}
            fetchpriority="high"
            decoding="sync"
            class="h-full w-full object-cover bg-line"
            style={`object-position:${hero.focus}`}
          />
        </div>
      </div>
    </div>
  </section>

  <div class="wrap"><div class="joint-rule" aria-hidden="true"></div></div>

  <!-- Services -->
  <section class="band" aria-labelledby="services-h">
    <div class="wrap">
      <div class="grid gap-6 md:grid-cols-[1fr_1.2fr] md:items-end">
        <h2 id="services-h">What we pour in Sioux Falls</h2>
        <p class="lede measure">From one cracked sidewalk panel to a new shop floor. Every job starts with a site visit and a set price.</p>
      </div>
      <ul class="mt-12 grid gap-8 md:grid-cols-3">
        {featured.map((s) => (
          <li>
            <a href={`/services/${s.slug}`} class="group block no-underline">
              <div class="aspect-[4/3] overflow-hidden rounded-md">
                <Photo name={s.photo!} ratio={4 / 3} sizes="(min-width: 768px) 33vw, 100vw" widths={[480, 800, 1100]} class="transition-transform duration-500 group-hover:scale-[1.03]" />
              </div>
              <h3 class="mt-4 text-[1.35rem] group-hover:text-quartz-deep">{s.name}</h3>
              <p class="mt-1.5 text-steel">{s.summary}</p>
            </a>
          </li>
        ))}
      </ul>
      <ul class="mt-12 grid border-t border-line md:grid-cols-2 md:gap-x-12">
        {rest.map((s) => (
          <li class="border-b border-line">
            <a href={`/services/${s.slug}`} class="group flex items-baseline justify-between gap-6 py-5 no-underline">
              <span>
                <span class="block text-[1.15rem] font-bold group-hover:text-quartz-deep" style="font-stretch:106%">{s.name}</span>
                <span class="mt-1 block text-[0.97rem] text-steel">{s.summary}</span>
              </span>
              <span class="shrink-0 text-sm font-semibold text-quartz-deep underline underline-offset-4">Details</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Sidewalk rules -->
  <section class="bg-paper" aria-labelledby="rules-h">
    <div class="wrap band grid items-center gap-12 lg:grid-cols-[0.9fr_1.1fr]">
      <div>
        <h2 id="rules-h">Got a sidewalk notice from the City?</h2>
        <p class="mt-5 measure">Sioux Falls inspects about 10 percent of its sidewalks every year. Panels that need work get marked with paint. Fixing them is on the property owner.</p>
        <ul class="list-check mt-6 measure">
          <li>A permit is needed before any sidewalk repair or replacement.</li>
          <li>Paid crews must be bonded and insured with the City.</li>
          <li>Small offsets up to 1 1/4 inch can be ground. Bigger ones are replaced.</li>
        </ul>
        <p class="mt-6"><Source k="cityRepairGuide" /></p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href="/guides/sioux-falls-sidewalk-repair" class="btn btn-plain">Read the sidewalk rules</a>
          <a href="/services/sidewalks" class="text-link self-center">Sidewalk repair service</a>
        </div>
      </div>
      <div class="rounded-md border border-line bg-slab p-5 sm:p-8">
        <SlabSection />
      </div>
    </div>
  </section>

  <!-- Winter -->
  <section class="band" aria-labelledby="winter-h">
    <div class="wrap grid items-center gap-12 lg:grid-cols-[1fr_1fr]">
      <div class="order-2 lg:order-1">
        <div class="aspect-[5/4] overflow-hidden rounded-md">
          <Photo name="sunnyPour" ratio={5 / 4} sizes="(min-width: 1024px) 50vw, 100vw" widths={[600, 900, 1300]} />
        </div>
      </div>
      <div class="order-1 lg:order-2">
        <h2 id="winter-h">Poured for freeze, thaw, and road salt</h2>
        <p class="mt-5 measure">Water gets into concrete, freezes, and pushes it apart. Salt makes it worse. That is why so many slabs around town flake and crack after a few winters.</p>
        <p class="mt-4 measure">Concrete with entrained air holds up much better. Tiny air bubbles in the mix give freezing water room to expand. Concrete that will see deicing salt should also reach about 4,000 psi before it faces repeated freeze and thaw.</p>
        <p class="mt-4 measure">So we plan the mix, the pour date, and the curing around the weather, not just the calendar.</p>
        <p class="mt-6"><Source k="cementFreezeThaw" /></p>
      </div>
    </div>
  </section>

  <!-- Process -->
  <section class="bg-ink text-slab" aria-labelledby="process-h">
    <div class="wrap band">
      <h2 id="process-h" class="max-w-2xl">How a concrete job goes</h2>
      <ol class="mt-12 grid gap-10 sm:grid-cols-2 lg:grid-cols-4">
        {[
          ['Call and describe the job', 'Tell us what you need, the address, and a rough size. Photos help if you can text them later.'],
          ['Site visit and price', 'We measure, check slope and drainage, and look at what is under the old slab. Then you get one price.'],
          ['Prep, forms, and pour', 'Old concrete comes out, the base is compacted, forms and steel go in, and the truck pours.'],
          ['Finish and cure', 'We finish, cut joints, and tell you when you can walk and drive on it.'],
        ].map(([t, d], i) => (
          <li class="border-t-2 border-quartz pt-5">
            <span class="block text-[2.6rem] font-extrabold leading-none text-quartz-light" style="font-stretch:120%">{i + 1}</span>
            <h3 class="mt-4">{t}</h3>
            <p class="mt-2 text-slab/75">{d}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- Areas -->
  <section class="band" aria-labelledby="areas-h">
    <div class="wrap grid gap-10 md:grid-cols-[1fr_1.4fr]">
      <div>
        <h2 id="areas-h">Sioux Falls and nearby towns</h2>
        <p class="lede mt-5">Our home base is Sioux Falls. We also pour in the towns around it.</p>
      </div>
      <div>
        <ul class="grid gap-x-10 sm:grid-cols-2">
          {TOWNS.map((t) => (
            <li class="border-b border-line">
              <a href={`/areas/${t.slug}`} class="group flex items-baseline justify-between py-4 no-underline">
                <span class="text-[1.15rem] font-bold group-hover:text-quartz-deep" style="font-stretch:106%">{t.name}</span>
                <span class="text-sm text-steel">{t.county}</span>
              </a>
            </li>
          ))}
          <li class="border-b border-line">
            <a href="/areas" class="flex items-baseline justify-between py-4 font-semibold text-quartz-deep underline underline-offset-4">All service areas</a>
          </li>
        </ul>
        <p class="mt-6 text-steel">Also: {ALSO_SERVED.join(', ')}.</p>
      </div>
    </div>
  </section>

  <div class="bg-paper">
    <Faq items={faqs} />
  </div>

  <CtaBand />
</Layout>
