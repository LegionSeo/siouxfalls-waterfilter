---
import Layout from '../layouts/Layout.astro';
import CtaBand from '../components/CtaBand.astro';
import Crumbs from '../components/Crumbs.astro';
import { SITE } from '../config/site';
import { SERVICES } from '../content/services';
import { TOWNS } from '../content/towns';
import { PHOTOS } from '../content/photos';
import { SOURCES } from '../content/sources';
import { breadcrumbNode } from '../lib/schema';
const crumbs = [{ name: 'Home', path: '/' }, { name: 'About', path: '/about' }];
const credits = Object.values(PHOTOS);
---
<Layout
  title="About Sioux Falls Concrete | Concrete Contractor in Sioux Falls, SD"
  description="About Sioux Falls Concrete: residential and commercial concrete work in Sioux Falls and nearby towns. Driveways, patios, sidewalks, slabs, and repair."
  graph={[breadcrumbNode(crumbs)]}
>
  <section class="wrap pb-10 pt-6">
    <Crumbs items={crumbs} />
    <h1 class="mt-8 max-w-[16ch]">About Sioux Falls Concrete</h1>
    <p class="lede mt-6 measure">Concrete work for homes and businesses in Sioux Falls and the towns around it.</p>
  </section>
  <div class="wrap"><div class="joint-rule" aria-hidden="true"></div></div>
  <section class="band-tight">
    <div class="wrap grid gap-12 lg:grid-cols-[1.3fr_1fr]">
      <div class="measure">
        <p>{SITE.name} pours and repairs concrete in Sioux Falls, {TOWNS.slice(0, -1).map((t) => t.name).join(', ')}, and {TOWNS.at(-1)!.name}. The work covers {SERVICES.map((s) => s.name.toLowerCase()).slice(0, -1).join(', ')}, and {SERVICES.at(-1)!.name.toLowerCase()}.</p>
        <p class="mt-4">We write this site in plain words. When we mention a city rule or a fact about concrete, we link to where it came from, so you can check it yourself.</p>
        <p class="mt-4">The best way to reach us is the phone. Call {SITE.phoneDisplay} and tell us about the job.</p>
        <h2 class="mt-12 text-[1.6rem]">Where our facts come from</h2>
        <ul class="list-check mt-5">
          {Object.values(SOURCES).map((s) => <li><a class="text-link font-normal" href={s.url} rel="nofollow noopener" target="_blank">{s.label}</a></li>)}
        </ul>
      </div>
      <div>
        <h2 class="text-[1.35rem]">Photo credits</h2>
        <p class="mt-3 text-[0.95rem] text-steel">Photos on this site are stock photos from Unsplash, used under the Unsplash License. They show concrete work in general, not our own jobs.</p>
        <ul class="mt-5 space-y-2 text-[0.95rem]">
          {credits.map((c) => <li><a class="text-link font-normal" href={c.page} rel="nofollow noopener" target="_blank">{c.credit}</a></li>)}
        </ul>
      </div>
    </div>
  </section>
  <CtaBand />
</Layout>
