---
import ContactLink from './ContactLink.astro';
import { townPages } from '../config/catalog';

const towns = townPages.filter((town) => town.live);
---

<aside class="page-rail">
  <div class="rail-card">
    <p class="eyebrow eyebrow-on-dark">Talk to us</p>
    <p class="rail-note">
      Call and tell us what you are noticing. Tell us your town and your water source.
    </p>
    <div class="rail-actions">
      <ContactLink track="call-rail" class="btn btn-mint w-full" />
      <a class="btn btn-line w-full" href="/contact">Request service</a>
    </div>
    <p class="rail-label">Towns served</p>
    <ul class="rail-towns">
      {
        towns.map((town) => (
          <li>
            <a href={town.href}>{town.name}</a>
          </li>
        ))
      }
    </ul>
  </div>
</aside>
