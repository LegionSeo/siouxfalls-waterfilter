---
import Layout from '../../layouts/Layout.astro';
import CtaBand from '../../components/CtaBand.astro';
import FaqAccordion from '../../components/FaqAccordion.astro';
import Icon from '../../components/Icon.astro';
import InlineText from '../../components/InlineText.astro';
import PageHero from '../../components/PageHero.astro';
import ServiceCards from '../../components/ServiceCards.astro';
import SideRail from '../../components/SideRail.astro';
import { joinNames, services, townPages } from '../../config/catalog';
import { servicePageBySlug, servicePages } from '../../content/service-pages';
import { UPDATED_ISO, UPDATED_LABEL } from '../../content/updated';
import { pagePhoto } from '../../lib/photos';
import { visitSteps } from '../../lib/visit-steps';
import { breadcrumb, serviceNode } from '../../lib/page-schema';
import { faqNode } from '../../lib/schema';
import { SITE } from '../../config/site';

function plainText(text: string): string {
  return text.replace(/\[([^\]]+)\]\([^)]+\)/g, '$1');
}

function withPhone(text: string): string {
  return text.replaceAll('{phone}', SITE.phoneDisplay);
}

export function getStaticPaths() {
  return servicePages.map((page) => ({ params: { slug: page.slug } }));
}

const { slug } = Astro.params;
const page = servicePageBySlug(slug);
if (!page) throw new Error(`Missing service page ${slug}`);

const path = `/services/${page.slug}`;
const photo = pagePhoto(page.photo, page.alt);
const answer = withPhone(page.answer);
const faqs = page.faqs.map((item) => ({ q: item.q, a: withPhone(item.a) }));
const related = page.related
  .map((href) => services.find((service) => service.href === href))
  .filter((service) => service?.live);
const liveTowns = townPages.filter((town) => town.live && town.href !== '/');
const catalogService = services.find((service) => service.href === path);
if (!catalogService) throw new Error(`Missing catalog service ${path}`);
const steps = visitSteps(page.visit);
if (!page.documentTitle.includes('Sioux Falls')) {
  throw new Error(`Service title must include the city: ${page.slug}`);
}
if (page.serviceType === catalogService.name) throw new Error(`serviceType must differ from name for ${page.slug}`);
const graph = [
  serviceNode(catalogService.name, page.serviceType, path, SITE.serviceTowns),
  breadcrumb([
    { name: 'Home', path: '/' },
    { name: page.title, path },
  ]),
  faqNode(faqs.map((item) => ({ question: item.q, paragraphs: [plainText(item.a)] }))),
];
---

<Layout title={page.documentTitle} schemaName={page.documentTitle} description={page.description} fullTitle extraGraph={graph} overlay>
  <PageHero photo={photo} eyebrow="Sioux Falls and nearby towns" title={page.title} sub={page.sub} />

  <div class="page-split">
    <div class="page-main">
      <section class="bg-paper">
        <div class="section">
          <p class="measure text-lg">
            <InlineText text={answer} />
          </p>
          <p class="mt-6 text-sm text-muted">Updated <time datetime={UPDATED_ISO}>{UPDATED_LABEL}</time></p>
        </div>
      </section>

      <section class="bg-white" aria-labelledby="included-heading">
        <div class="section">
          <div class="block-head">
            <h2 id="included-heading">{page.includedHeading}</h2>
            <p class="lede"><InlineText text={page.includedLead} /></p>
          </div>
          <ul class="card-grid cols-2">
            {
              page.included.map((item) => (
                <li class="icon-card">
                  <span class="icon-chip">
                    <Icon name="check" />
                  </span>
                  <p><InlineText text={item} /></p>
                </li>
              ))
            }
          </ul>
        </div>
      </section>

      <section class="bg-paper" aria-labelledby="signs-heading">
        <div class="section">
          <div class="block-head">
            <h2 id="signs-heading">{page.signsHeading}</h2>
            <p class="lede"><InlineText text={page.signsLead} /></p>
          </div>
          <ul class="card-grid cols-2">
            {
              page.signs.map((item) => (
                <li class="icon-card">
                  <span class="icon-chip">
                    <Icon name="drop" />
                  </span>
                  <p><InlineText text={item} /></p>
                </li>
              ))
            }
          </ul>
          {
            page.compare && (
              <>
                <h2 id="compare-heading" class="mt-12">{page.compare.heading}</h2>
                <p class="lede"><InlineText text={page.compare.lead} /></p>
                <ul class="card-grid cols-2 mt-6">
                  {
                    page.compare.rows.map((row) => (
                      <li class="icon-card">
                        <span class="icon-chip">
                          <Icon name="check" />
                        </span>
                        <p>
                          <strong>{row.title}.</strong> <InlineText text={row.text} />
                        </p>
                      </li>
                    ))
                  }
                </ul>
              </>
            )
          }
        </div>
      </section>

      <section class="bg-white" aria-labelledby="cost-heading">
        <div class="section">
          <div class="block-head">
            <h2 id="cost-heading">What affects the price</h2>
            <p class="lede">{page.costLead}</p>
          </div>
          <ol class="card-grid cols-2">
            {
              page.cost.map((paragraph, index) => (
                <li class="num-card">
                  <span class="num">{index + 1}</span>
                  <p><InlineText text={paragraph} /></p>
                </li>
              ))
            }
          </ol>
          <h2 id="note-heading" class="mt-12">{page.noteHeading}</h2>
          <p class="measure mt-4 text-muted"><InlineText text={page.note} /></p>
        </div>
      </section>

      <section class="surface-dark bg-ink text-white" aria-labelledby="visit-heading">
        <div class="section">
          <div class="block-head">
            <h2 id="visit-heading" class="text-white">How it works</h2>
            <p class="lede on-dark">We start with your water. If we find something else, we tell you before we do anything about it.</p>
          </div>
          <ol class="grid gap-8 md:grid-cols-3">
            {
              steps.map((step, index) => (
                <li>
                  <span class="step-num">{index + 1}</span>
                  <h3 class="mt-4 text-white">{step.title}</h3>
                  <p class="mt-2 on-dark"><InlineText text={step.text} /></p>
                </li>
              ))
            }
          </ol>
        </div>
      </section>

      <section class="bg-paper" aria-labelledby="towns-heading">
        <div class="section">
          <div class="block-head">
            <h2 id="towns-heading">Towns served</h2>
            <p class="lede">
              We help homes in {joinNames(SITE.serviceTowns)}. See the <a class="text-link" href="/service-area">service area</a>.
            </p>
          </div>
          <ul class="flex flex-wrap gap-2">
            <li><a class="town-chip" href="/#service-area">Sioux Falls</a></li>
            {liveTowns.map((town) => <li><a class="town-chip" href={town.href}>{town.name}</a></li>)}
          </ul>
          <div class="block-head mt-12">
            <h2 id="related-heading">Related services</h2>
            <p class="lede">These often go together. Open a card to see what each one covers.</p>
          </div>
          <ServiceCards services={related} />
          <p class="mt-6">
            <a class="text-link" href="/contact">Contact {SITE.name}</a>
          </p>
        </div>
      </section>

      <FaqAccordion items={faqs} heading="Questions we hear a lot" />
    </div>
    <SideRail />
  </div>

  <CtaBand photo={photo} heading={`Need help with ${page.ctaName}?`} />
</Layout>
