---
import Layout from '../layouts/Layout.astro';
import CtaBand from '../components/CtaBand.astro';
import FaqAccordion from '../components/FaqAccordion.astro';
import PageHero from '../components/PageHero.astro';
import SideRail from '../components/SideRail.astro';
import { joinNames, services, townPages } from '../config/catalog';
import { UPDATED_ISO, UPDATED_LABEL } from '../content/updated';
import { pagePhoto } from '../lib/photos';
import { breadcrumb } from '../lib/page-schema';
import { SITE, formatAddress } from '../config/site';

const liveServices = services.filter((service) => service.live);
const liveTowns = townPages.filter((town) => town.live && town.href !== '/');
const hero = pagePhoto('hero-about', 'White service van parked in a residential driveway with its side door open');
const faqs = [
  {
    q: 'Where are you located?',
    a: `We serve ${formatAddress()} and the towns around it. We come to you, so there is no storefront to visit.`,
  },
  {
    q: 'How do I ask for help?',
    a: `Call ${SITE.phoneDisplay} or use the contact page. Tell us your town, your water source, and what you have noticed.`,
  },
];
const graph = [
  breadcrumb([
    { name: 'Home', path: '/' },
    { name: 'About', path: '/about' },
  ]),
];
---

<Layout
  title="About Sioux Falls Water Filtration | Sioux Falls, SD"
  schemaName="About Sioux Falls Water Filtration"
  description={`About ${SITE.name}: help with hard water, filtration, and well water in Sioux Falls and nearby towns. Call ${SITE.phoneDisplay}.`}
  fullTitle
  extraGraph={graph}
  overlay
>
  <PageHero photo={hero} eyebrow={SITE.name} title="About Sioux Falls Water Filtration" sub="Help with hard water, filtration, and well water in Sioux Falls and the towns around it." />

  <div class="page-split">
    <div class="page-main">
      <section class="bg-paper">
        <div class="section">
          <p class="measure text-lg">
            {SITE.name} helps people in Sioux Falls and nearby towns with the water in their homes. That means softeners, filtration, drinking water systems, iron and sulfur problems, well water, and water testing.
          </p>
          <p class="mt-4 measure text-muted">
            We like to start with your water and not with a sales pitch. If a simple change will solve your problem, we want you to know that.
          </p>
          <p class="mt-6 text-sm text-muted">Updated <time datetime={UPDATED_ISO}>{UPDATED_LABEL}</time></p>
        </div>
      </section>

      <section class="bg-white" aria-labelledby="work-heading">
        <div class="section">
          <div class="block-head">
            <h2 id="work-heading">What we help with</h2>
            <p class="lede">Each name below opens its own page.</p>
          </div>
          <ul class="card-grid cols-2">
            {
              liveServices.map((service) => (
                <li>
                  <a class="text-card" href={service.href}>
                    {service.name}
                    <span class="mt-2 block text-sm font-normal text-muted">{service.summary}</span>
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
      </section>

      <section class="bg-paper" aria-labelledby="area-heading">
        <div class="section">
          <div class="block-head">
            <h2 id="area-heading">Where we work</h2>
            <p class="lede">Sioux Falls is home. {joinNames(liveTowns.map((town) => town.name))} have their own pages.</p>
          </div>
          <p><a class="text-link" href="/service-area">Read the service area page</a></p>
        </div>
      </section>

      <FaqAccordion items={faqs} heading="Good to know" />
    </div>
    <SideRail />
  </div>

  <CtaBand photo={hero} heading="Tell us about your water" />
</Layout>
