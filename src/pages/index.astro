---
import Layout from '../layouts/Layout.astro';
import ContactLink from '../components/ContactLink.astro';
import Icon from '../components/Icon.astro';
import InlineText from '../components/InlineText.astro';
import Photo from '../components/Photo.astro';
import RequestPanel from '../components/RequestPanel.astro';
import { joinNames, services, townPages } from '../config/catalog';
import { SITE, mapsUrl } from '../config/site';
import { HARD_WATER } from '../config/water';
import { homeFaqs } from '../content/home';
import { faqNode } from '../lib/schema';

const faqs = homeFaqs;
const homeTitle = 'Water Softeners and Filtration in Sioux Falls, SD';
const homeDescription = `Sioux Falls has very hard water. We help with water softeners, filtration, reverse osmosis, and water testing in Sioux Falls, Brandon, Harrisburg, Tea, and nearby. Call ${SITE.phoneDisplay}.`;

const cards = services.map((service) => {
  const photo = SITE.servicePhotos[service.href];
  if (!photo) throw new Error(`Missing service photo ${service.href}`);
  return { service, photo };
});

const cityPhoto = SITE.servicePhotos['/services/water-softeners'];
const wellPhoto = SITE.servicePhotos['/services/well-water-treatment'];
const cardSizes = '(min-width: 1024px) 360px, (min-width: 700px) 45vw, 100vw';
const areaMapSrc = 'https://maps.google.com/maps?ll=43.5460,-96.7313&z=8&t=m&hl=en&output=embed';

const hardSigns = [
  'White crust on faucets and shower heads',
  'Cloudy glasses and spotty dishes',
  'Soap that will not lather',
  'Dry skin and dull hair',
  'A noisy water heater',
  'Stiff towels and laundry',
];

const steps = [
  {
    title: 'You call',
    text: 'Tell us your town and whether you have city water, rural water, or a well. Tell us what you have noticed.',
  },
  {
    title: 'We look at your water',
    text: 'We check your water and your plumbing before we suggest anything. You will know what you are treating and why.',
  },
  {
    title: 'We set it up right',
    text: 'We install the system you choose and set it for your water. Then we show you how to care for it.',
  },
];
---

<Layout title={homeTitle} schemaName={homeTitle} description={homeDescription} fullTitle extraGraph={[faqNode(faqs)]} overlay>
  <link
    slot="head"
    rel="preload"
    as="image"
    href="/images/hero-water-1280.avif"
    imagesrcset={SITE.heroPhoto.avifSrcset}
    imagesizes="100vw"
    type="image/avif"
    fetchpriority="high"
  />

  <section class="hero hero-home surface-dark">
    <div class="hero-media">
      <Photo photo={SITE.heroPhoto} pictureClass="hero-picture" sizes="100vw" loading="eager" fetchpriority="high" class="hero-img" />
      <div class="hero-shade" aria-hidden="true"></div>
    </div>
    <div class="wrap hero-copy">
      <p class="eyebrow eyebrow-on-dark">Sioux Falls &amp; nearby towns</p>
      <h1>
        Hard Water Help in<br />
        Sioux Falls, SD
      </h1>
      <p class="hero-sub">
        Sioux Falls water is very hard. We help you soften it, filter it, and enjoy drinking it. City water, rural water, or your own well.
      </p>
      <div class="mt-8 flex flex-col gap-3 sm:flex-row">
        <ContactLink track="call-hero" class="btn btn-mint w-full sm:w-auto" />
        <a href="#quote" class="btn btn-line w-full sm:w-auto">
          <Icon name="arrow" class="h-5 w-5" />
          Request service
        </a>
      </div>
      <ul class="mt-8 grid gap-4 sm:grid-cols-3">
        <li class="flex items-start gap-3 text-sm font-semibold">
          <Icon name="drop" class="mt-0.5 h-6 w-6 shrink-0 text-lagoon" />
          <span>Softeners and filtration</span>
        </li>
        <li class="flex items-start gap-3 text-sm font-semibold">
          <Icon name="tube" class="mt-0.5 h-6 w-6 shrink-0 text-lagoon" />
          <span>Your water checked first</span>
        </li>
        <li class="flex items-start gap-3 text-sm font-semibold">
          <Icon name="home" class="mt-0.5 h-6 w-6 shrink-0 text-lagoon" />
          <span>City, rural, or well</span>
        </li>
      </ul>
    </div>
  </section>

  <section class="bg-white" aria-labelledby="hard-heading">
    <div class="wrap section">
      <div class="section-head">
        <p class="eyebrow">The Sioux Falls water story</p>
        <h2 id="hard-heading">Your water is harder than most</h2>
        <p class="lede">
          Sioux Falls gets its water from its own plant and from the Lewis &amp; Clark system. Both are hard. The city publishes the numbers every year.
        </p>
      </div>
      <div class="hard-grid">
        <div class="hard-tile">
          <p class="hard-num">{HARD_WATER.cityGpg}<span> grains per gallon</span></p>
          <p class="hard-label">City of Sioux Falls plant water</p>
          <p class="text-sm text-muted">Considered very hard.</p>
        </div>
        <div class="hard-tile">
          <p class="hard-num">{HARD_WATER.lewisClarkGpg}<span> grains per gallon</span></p>
          <p class="hard-label">Lewis &amp; Clark water</p>
          <p class="text-sm text-muted">Considered hard.</p>
        </div>
      </div>
      <p class="mt-4 text-sm text-muted">
        Approximate averages from the{' '}
        <a class="text-link" href={HARD_WATER.sourceUrl} rel="noopener noreferrer">{HARD_WATER.sourceName}</a>, {HARD_WATER.reportYear} data.
        The number at your tap can change. <a class="text-link" href="/guides/hard-water-sioux-falls">Read our hard water guide</a>.
      </p>
      <h3 class="mt-12">Signs hard water is at work in your home</h3>
      <ul class="trust-grid mt-6">
        {
          hardSigns.map((sign) => (
            <li class="flex items-start gap-3">
              <span class="icon-chip shrink-0">
                <Icon name="drop" />
              </span>
              <p class="font-semibold">{sign}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section id="services" class="bg-paper" aria-labelledby="services-heading">
    <div class="wrap section">
      <div class="section-head">
        <h2 id="services-heading">Water treatment services in Sioux Falls</h2>
        <p class="lede">Pick the one that sounds like your problem. Not sure? Call us and we will figure it out together.</p>
      </div>
      <ul class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {
          cards.map(({ service, photo }) => (
            <li>
              <a href={service.href} class="card">
                <Photo photo={photo} sizes={cardSizes} loading="lazy" class="aspect-[4/3] w-full object-cover" />
                <span class="flex flex-1 flex-col p-5">
                  <h3>{service.name}</h3>
                  <p class="mt-2 flex-1 text-sm leading-relaxed text-muted">{service.summary}</p>
                  <span class="mt-4 text-sm font-semibold text-lagoon">Learn more →</span>
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="bg-white" aria-labelledby="help-heading">
    <div class="wrap section">
      <div class="section-head">
        <h2 id="help-heading">City water or well water, we can help</h2>
        <p class="lede">Your water source shapes everything. Tell us which one you have and we will start there.</p>
      </div>
      <div class="grid gap-6 md:grid-cols-2">
        <a href="/services/water-softeners" class="split-panel">
          <Photo photo={cityPhoto} pictureClass="hero-picture" sizes="(min-width: 768px) 50vw, 100vw" loading="lazy" class="hero-img" />
          <span class="split-shade" aria-hidden="true"></span>
          <span class="relative flex flex-1 flex-col justify-end p-8">
            <h3 class="text-white">On city or rural water</h3>
            <p class="mt-3 max-w-[36ch] on-dark-soft">Your water is treated before it reaches you. Hardness and taste are usually what is left to deal with.</p>
            <span class="btn btn-line mt-6 w-fit">See water softeners</span>
          </span>
        </a>
        <a href="/services/well-water-treatment" class="split-panel">
          <Photo photo={wellPhoto} pictureClass="hero-picture" sizes="(min-width: 768px) 50vw, 100vw" loading="lazy" class="hero-img" />
          <span class="split-shade" aria-hidden="true"></span>
          <span class="relative flex flex-1 flex-col justify-end p-8">
            <h3 class="text-white">On a private well</h3>
            <p class="mt-3 max-w-[36ch] on-dark-soft">Nobody tests your well but you. Iron, sulfur, and hardness are common, and a test comes first.</p>
            <span class="btn btn-line mt-6 w-fit">See well water treatment</span>
          </span>
        </a>
      </div>
    </div>
  </section>

  <section id="how-it-works" class="surface-dark bg-ink text-white" aria-labelledby="process-heading">
    <div class="wrap section">
      <div class="section-head">
        <h2 id="process-heading" class="text-white">How it works</h2>
        <p class="lede on-dark">You call, we look at your water, and then we set up what fits.</p>
      </div>
      <ol class="grid gap-8 md:grid-cols-3">
        {
          steps.map((step, index) => (
            <li>
              <span class="step-num">{index + 1}</span>
              <h3 class="mt-4 text-white">{step.title}</h3>
              <p class="mt-2 on-dark">{step.text}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section id="service-area" class="bg-white" aria-labelledby="area-heading">
    <div class="wrap section">
      <div class="section-head">
        <h2 id="area-heading">Serving Sioux Falls and nearby towns</h2>
        <div class="lede stack-md">
          <p>
            Inside Sioux Falls, your water is likely a mix from the city plant and Lewis &amp; Clark. On the edges of town and out on acreages, you may be on rural water or your own well.
          </p>
          <p>
            Live outside the city? {joinNames(townPages.filter((town) => town.live && town.href !== '/').map((town) => town.name))} have their own pages. We also take calls from {joinNames(SITE.listOnlyTowns)}.
          </p>
        </div>
      </div>
      <div class="area-grid">
        <div class="area-map">
          <div class="home-map-frame">
            <iframe
              class="home-map"
              src={areaMapSrc}
              title="Map of Sioux Falls, South Dakota and nearby towns"
              loading="lazy"
              referrerpolicy="no-referrer-when-downgrade"
              allowfullscreen
              width="800"
              height="600"
            ></iframe>
          </div>
          <a class="home-map-link text-link" href={mapsUrl()} target="_blank" rel="noopener noreferrer">Open in Google Maps</a>
        </div>
        <ul class="area-towns">
          {
            townPages.map((town) => (
              <li>
                <a class="town-chip" href={town.href}>
                  <Icon name="pin" class="h-4 w-4" />
                  {town.name}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <section id="faq" class="bg-paper" aria-labelledby="faq-heading">
    <div class="wrap section">
      <div class="faq-col">
        <div class="section-head">
          <h2 id="faq-heading">Sioux Falls water questions</h2>
          <p class="lede">Here are the questions we hear most. If yours is not here, just call.</p>
        </div>
        <div class="faq">
          {
            faqs.map((item) => (
              <details>
                <summary class="flex items-center justify-between gap-4">
                  <h3 class="text-lg">{item.question}</h3>
                  <span class="faq-plus text-2xl font-bold leading-none text-lagoon" aria-hidden="true">+</span>
                  <span class="faq-minus text-2xl font-bold leading-none text-lagoon" aria-hidden="true">−</span>
                </summary>
                {item.paragraphs.map((paragraph) => <p class="measure mt-3 text-muted"><InlineText text={paragraph} /></p>)}
              </details>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <section id="quote" class="surface-dark relative overflow-hidden bg-ink text-white">
    <Photo photo={SITE.heroPhoto} pictureClass="hero-picture opacity-30" sizes="100vw" loading="lazy" class="hero-img" />
    <div class="absolute inset-0 ink-shade" aria-hidden="true"></div>
    <div class="wrap section relative">
      <h2 class="max-w-[22ch] text-white">Ready for better water in Sioux Falls?</h2>
      <p class="mt-4 max-w-[46ch] on-dark-soft">Tell us your town and what you are noticing. We are happy to help you figure it out.</p>
      <div class="mt-12 flex flex-col gap-3 sm:flex-row sm:items-center">
        <ContactLink track="call-quote" class="btn btn-mint w-full sm:w-auto" />
        <p class="on-dark-soft">
          <span>Prefer to write?</span>
          <a class="ml-1 font-semibold text-white underline" href={`mailto:${SITE.email}`} data-track="email-quote">Email {SITE.email}</a>
        </p>
      </div>
      <div class="mt-8 max-w-xl rounded-2xl bg-white p-6 text-text">
        <RequestPanel heading="Request service" headingTag="p" intro="Tell us a little about your water." callTrack="call-quote-form" smsTrack="sms-quote-form" formIdPrefix="quote" />
      </div>
    </div>
  </section>

  {
    SITE.jobPhotos.length > 0 && (
      <section class="wrap section" aria-label="Job photos">
        <ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {SITE.jobPhotos.map((photo) => (
            <li>
              <img src={photo.src} alt={photo.alt} width={photo.width} height={photo.height} class="h-auto w-full rounded-2xl" loading="lazy" decoding="async" />
            </li>
          ))}
        </ul>
      </section>
    )
  }
</Layout>
