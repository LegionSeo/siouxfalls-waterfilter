---
import Layout from '../../layouts/Layout.astro';
import CtaBand from '../../components/CtaBand.astro';
import Icon from '../../components/Icon.astro';
import { SITE } from '../../config/site';
import { towns } from '../../content/towns';
import { breadcrumbNode } from '../../lib/schema';
---

<Layout
  title="Areas We Serve | Sioux Falls Water Filters"
  description="Water filters, softeners and reverse osmosis for Sioux Falls, Brandon, Harrisburg, Tea, Lennox, Hartford and nearby acreages."
  graph={[breadcrumbNode([{ name: 'Home', path: '/' }, { name: 'Areas', path: '/areas' }])]}
>
  <section class="wrap py-12 md:py-16">
    <p class="kicker">Areas we serve</p>
    <h1 class="mt-3">Water filters for Sioux Falls and nearby towns</h1>
    <p class="lede mt-5">
      Water is not the same in every town. Some towns buy water from Lewis &amp; Clark, some treat their own, and many acreages
      use private wells. Pick your town to see what we know about its water.
    </p>
    <ul class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      <li>
        <a href="/" class="card flex items-center gap-4 no-underline hover:border-cobalt">
          <Icon name="pin" class="h-6 w-6 text-cobalt" />
          <span class="font-display text-lg font-semibold text-ink">Sioux Falls</span>
        </a>
      </li>
      {
        towns.map((town) => (
          <li>
            <a href={`/areas/${town.slug}`} class="card flex items-center gap-4 no-underline hover:border-cobalt">
              <Icon name="pin" class="h-6 w-6 text-cobalt" />
              <span class="font-display text-lg font-semibold text-ink">{town.name}</span>
            </a>
          </li>
        ))
      }
    </ul>
    <p class="mt-10 text-muted">
      We also take calls from {SITE.nearbyTowns.join(', ')} and rural homes in between. Call {SITE.phoneDisplay} and tell us where you are.
    </p>
  </section>
  <CtaBand />
</Layout>
