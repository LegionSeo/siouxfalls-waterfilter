---
import Layout from '../layouts/Layout.astro';
import CallButton from '../components/CallButton.astro';
import CtaBand from '../components/CtaBand.astro';
import Faq from '../components/Faq.astro';
import Icon from '../components/Icon.astro';
import { SITE } from '../config/site';
import { services } from '../content/services';
import { towns } from '../content/towns';
import { SF_REPORT } from '../content/water';
import { faqNode } from '../lib/schema';

const title = 'Whole House Water Filters Sioux Falls, SD | Softeners and RO';
const description = `Whole house water filters, water softeners and reverse osmosis for Sioux Falls homes. Free in home water test. Call ${SITE.phoneDisplay}.`;

const problems = [
  { problem: 'White crust, spots and scale', fix: 'Water softener', href: '/water-softener-installation' },
  { problem: 'Chlorine taste or pool smell', fix: 'Whole house filter', href: '/whole-house-water-filter' },
  { problem: 'Hard water and chlorine taste', fix: 'Softener and filter combo', href: '/softener-and-filter-combo' },
  { problem: 'I want better drinking water', fix: 'Reverse osmosis', href: '/reverse-osmosis-installation' },
  { problem: 'Orange stains or a rotten egg smell', fix: 'Well water system', href: '/well-water-filtration' },
  { problem: 'My softener quit working', fix: 'Softener service', href: '/water-filter-service' },
];

const steps = [
  {
    title: SITE.freeTest ? 'Free water test' : 'Water test',
    text: 'We test the water at your kitchen tap. You see your hardness, chlorine and iron numbers.',
  },
  {
    title: 'Clear options',
    text: 'We show you what each system fixes and what it costs to own. You pick, with no pressure.',
  },
  {
    title: 'Clean install',
    text: 'Most installs take one visit. We set the system for your water and show you the upkeep.',
  },
];

const compare = [
  { name: 'Water softener', removes: 'Hardness minerals that cause scale', where: 'Whole house', upkeep: 'Add salt, yearly check' },
  { name: 'Whole house filter', removes: 'Chlorine, sediment, odors', where: 'Whole house', upkeep: 'Change cartridge or media' },
  { name: 'Reverse osmosis', removes: 'Most dissolved solids and sodium', where: 'One kitchen faucet', upkeep: 'Filters yearly, membrane every few years' },
];

const faqs = [
  {
    q: 'How hard is Sioux Falls water?',
    a: `Hard. The City of Sioux Falls ${SF_REPORT.year} water report lists a softener setting of ${SF_REPORT.plantGpg} grains per gallon for water from its plant and ${SF_REPORT.lewisClarkGpg} for Lewis & Clark water. Anything over about 7 grains is usually called hard.`,
  },
  {
    q: 'Why does my tap water taste like chlorine?',
    a: `The city uses chlorine to keep water safe in the pipes. Its ${SF_REPORT.year} report lists an average total chlorine level of ${SF_REPORT.chlorinePpm} parts per million, which is within the safe limit. A [whole house filter](/whole-house-water-filter) takes the taste out at every tap.`,
  },
  {
    q: 'What is the difference between a whole house filter and a softener?',
    a: 'A filter takes out things like chlorine, sediment and odors. A softener takes out the minerals that cause scale. Many Sioux Falls homes want both, so we install them together as a [combo system](/softener-and-filter-combo).',
  },
  {
    q: 'Is Sioux Falls water safe to drink?',
    a: `The city's ${SF_REPORT.year} report says no health based drinking water violations were recorded that year. Most filter and softener jobs here are about taste, scale and comfort, not safety.`,
  },
  {
    q: 'Do you install on homes with a private well?',
    a: 'Yes. Wells around Sioux Falls often need iron and smell treatment first. See [well water filter systems](/well-water-filtration).',
  },
];
---

<Layout title={title} description={description} graph={[faqNode(faqs)]}>
  <section class="relative overflow-hidden">
    <div class="wrap grid items-center gap-10 py-14 md:grid-cols-[1.15fr_1fr] md:py-20">
      <div>
        <p class="kicker"><Icon name="pin" class="h-4 w-4" /> Sioux Falls, SD and nearby towns</p>
        <h1 class="mt-4">Whole House Water Filters for Sioux Falls Homes</h1>
        <p class="lede mt-5">
          Hard water and chlorine taste are the two big complaints in Sioux Falls. We test your water at your tap, then install
          the filter or softener that fixes it.
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <CallButton track="call-hero" />
          <a href="/free-water-test" class="btn btn-ghost">{SITE.freeTest ? 'Book a free water test' : 'Book a water test'}</a>
        </div>
        <ul class="mt-8 grid gap-2 text-[0.95rem] text-muted sm:grid-cols-2">
          <li class="flex items-center gap-2"><Icon name="check" class="h-5 w-5 text-cobalt" /> Whole house filters</li>
          <li class="flex items-center gap-2"><Icon name="check" class="h-5 w-5 text-cobalt" /> Water softeners</li>
          <li class="flex items-center gap-2"><Icon name="check" class="h-5 w-5 text-cobalt" /> Reverse osmosis</li>
          <li class="flex items-center gap-2"><Icon name="check" class="h-5 w-5 text-cobalt" /> Well water systems</li>
        </ul>
      </div>
      <aside class="card relative p-7 shadow-[0_24px_60px_-30px_rgba(16,33,58,0.45)]" aria-labelledby="water-card">
        <p class="kicker">From the city water report</p>
        <h2 id="water-card" class="mt-2 text-2xl">Sioux Falls city water at a glance</h2>
        <dl class="mt-6 grid gap-4">
          <div class="flex items-baseline justify-between gap-4 rounded-2xl bg-sky px-5 py-4">
            <dt class="text-sm font-semibold text-muted">Hardness, city plant</dt>
            <dd class="font-display text-3xl font-bold text-ink">{SF_REPORT.plantGpg} <span class="text-base font-semibold">gpg</span></dd>
          </div>
          <div class="flex items-baseline justify-between gap-4 rounded-2xl bg-sky px-5 py-4">
            <dt class="text-sm font-semibold text-muted">Hardness, Lewis &amp; Clark</dt>
            <dd class="font-display text-3xl font-bold text-ink">{SF_REPORT.lewisClarkGpg} <span class="text-base font-semibold">gpg</span></dd>
          </div>
          <div class="flex items-baseline justify-between gap-4 rounded-2xl bg-sand px-5 py-4">
            <dt class="text-sm font-semibold text-muted">Average chlorine</dt>
            <dd class="font-display text-3xl font-bold text-ink">{SF_REPORT.chlorinePpm} <span class="text-base font-semibold">ppm</span></dd>
          </div>
        </dl>
        <p class="mt-5 text-xs text-muted">
          Source: <a class="underline" href={SF_REPORT.url} rel="noopener">{SF_REPORT.name}</a>. gpg means grains per gallon. Water over about 7 gpg is
          usually called hard.
        </p>
      </aside>
    </div>
  </section>

  <section class="band bg-white" aria-labelledby="problem-heading">
    <div class="wrap">
      <p class="kicker">Start with the problem</p>
      <h2 id="problem-heading" class="mt-3 max-w-2xl">What is bugging you about your water?</h2>
      <p class="lede mt-4">Pick the one that sounds like your house. Each one opens the fix that usually works.</p>
      <ul class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {
          problems.map((item) => (
            <li>
              <a href={item.href} class="card group flex h-full flex-col justify-between gap-6 no-underline transition hover:border-cobalt">
                <span class="font-display text-xl font-semibold text-ink">{item.problem}</span>
                <span class="flex items-center justify-between text-sm font-bold text-cobalt">
                  {item.fix}
                  <span aria-hidden="true" class="transition group-hover:translate-x-1">&rarr;</span>
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="band" aria-labelledby="systems-heading">
    <div class="wrap">
      <p class="kicker">Systems and services</p>
      <h2 id="systems-heading" class="mt-3">Everything for whole home water</h2>
      <ul class="mt-10 grid gap-5 md:grid-cols-2">
        {
          services.map((service) => (
            <li>
              <a href={`/${service.slug}`} class="card flex h-full gap-5 no-underline transition hover:border-cobalt">
                <span class="grid h-12 w-12 shrink-0 place-items-center rounded-2xl bg-sky text-cobalt">
                  <Icon name={service.icon} />
                </span>
                <span>
                  <span class="block font-display text-lg font-semibold text-ink">{service.name}</span>
                  <span class="mt-1 block text-[0.95rem] text-muted">{service.card}</span>
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="band bg-ink text-white" aria-labelledby="how-heading">
    <div class="wrap">
      <p class="kicker !text-sun">How it works</p>
      <h2 id="how-heading" class="mt-3 !text-white">Test, choose, install</h2>
      <ol class="mt-10 grid gap-6 md:grid-cols-3">
        {
          steps.map((step, index) => (
            <li class="rounded-3xl border border-white/15 p-6">
              <span class="font-display text-4xl font-bold text-sun">{index + 1}</span>
              <h3 class="mt-3 !text-white">{step.title}</h3>
              <p class="mt-2 text-white/80">{step.text}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="band bg-white" aria-labelledby="compare-heading">
    <div class="wrap">
      <p class="kicker">Quick compare</p>
      <h2 id="compare-heading" class="mt-3">Softener, filter or reverse osmosis?</h2>
      <p class="lede mt-4">They do different jobs. Many Sioux Falls homes end up with two of the three.</p>
      <div class="mt-8 overflow-x-auto rounded-2xl border border-line">
        <table class="w-full min-w-[40rem] text-left text-[0.95rem]">
          <thead class="bg-sand font-display text-ink">
            <tr>
              <th class="px-5 py-3" scope="col">System</th>
              <th class="px-5 py-3" scope="col">What it takes out</th>
              <th class="px-5 py-3" scope="col">Where it works</th>
              <th class="px-5 py-3" scope="col">Upkeep</th>
            </tr>
          </thead>
          <tbody>
            {
              compare.map((row) => (
                <tr class="border-t border-line">
                  <th class="px-5 py-4 font-semibold text-ink" scope="row">{row.name}</th>
                  <td class="px-5 py-4 text-muted">{row.removes}</td>
                  <td class="px-5 py-4 text-muted">{row.where}</td>
                  <td class="px-5 py-4 text-muted">{row.upkeep}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
      <p class="mt-6">
        <a class="link" href="/softener-size-calculator">Figure out what size softener you need</a>
      </p>
    </div>
  </section>

  <section class="band" aria-labelledby="areas-heading">
    <div class="wrap grid gap-8 md:grid-cols-[1fr_1.4fr] md:items-center">
      <div>
        <p class="kicker">Areas we serve</p>
        <h2 id="areas-heading" class="mt-3">Sioux Falls and the towns around it</h2>
        <p class="lede mt-4">Each town page covers where the water comes from and what most homes there need.</p>
      </div>
      <ul class="flex flex-wrap gap-3">
        {
          towns.map((town) => (
            <li>
              <a href={`/areas/${town.slug}`} class="btn bg-white text-ink ring-1 ring-line hover:ring-cobalt">
                <Icon name="pin" class="h-4 w-4 text-cobalt" /> {town.name}
              </a>
            </li>
          ))
        }
        <li><a href="/areas" class="btn btn-blue">All areas</a></li>
      </ul>
    </div>
  </section>

  <Faq items={faqs} heading="Sioux Falls water questions" />
  <CtaBand />
</Layout>
