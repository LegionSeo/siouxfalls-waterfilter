---
import Layout from '../layouts/Layout.astro';
import CallButton from '../components/CallButton.astro';
import CtaBand from '../components/CtaBand.astro';
import Faq from '../components/Faq.astro';
import Photo from '../components/Photo.astro';
import Icon from '../components/Icon.astro';
import type { IconName } from '../content/services';
import { SITE } from '../config/site';
import { services } from '../content/services';
import { towns } from '../content/towns';
import { SF_REPORT } from '../content/water';
import { faqNode } from '../lib/schema';

const title = 'Whole House Water Filters Sioux Falls, SD | Softeners and RO';
const description = `Whole house water filters, water softeners and reverse osmosis for Sioux Falls homes. Free in home water test. Call ${SITE.phoneDisplay}.`;

const problems: { problem: string; fix: string; href: string; icon: IconName }[] = [
  { problem: 'White crust, spots and scale', fix: 'Water softener', href: '/water-softener-installation', icon: 'drop' },
  { problem: 'Chlorine taste or pool smell', fix: 'Whole house filter', href: '/whole-house-water-filter', icon: 'house' },
  { problem: 'Hard water and chlorine taste', fix: 'Softener and filter combo', href: '/softener-and-filter-combo', icon: 'layers' },
  { problem: 'I want better drinking water', fix: 'Reverse osmosis', href: '/reverse-osmosis-installation', icon: 'glass' },
  { problem: 'Orange stains or a rotten egg smell', fix: 'Well water system', href: '/well-water-filtration', icon: 'well' },
  { problem: 'My softener quit working', fix: 'Softener service', href: '/water-filter-service', icon: 'wrench' },
];

const featured = SITE.freeTest ? services.find((service) => service.slug === 'free-water-test') : undefined;
const lead = services.find((service) => service.slug === 'whole-house-water-filter')!;
const rest = services.filter((service) => service !== lead);

const trust: { title: string; text: string; icon: IconName }[] = [
  { title: SITE.freeTest ? 'Free in home water test' : 'Water test before any quote', text: 'We test at your kitchen tap.', icon: 'test' },
  { title: 'Clear price up front', text: 'You see the cost before work starts.', icon: 'check' },
  { title: 'City water, rural water or a well', text: 'Each one needs a different fix.', icon: 'well' },
  { title: 'Service on systems you own', text: 'Repairs, resets and filter changes.', icon: 'wrench' },
];

/** Meter scale for the hardness bars on the water card. Hard starts near 7 gpg. */
const scaleMax = 20;
const hardAt = 7;
const pct = (value: number) => `${Math.min(100, (value / scaleMax) * 100)}%`;
const readings = [
  { label: 'Hardness, city plant water', value: SF_REPORT.plantGpg, unit: 'gpg' },
  { label: 'Hardness, Lewis & Clark water', value: SF_REPORT.lewisClarkGpg, unit: 'gpg' },
];

const steps = [
  {
    title: SITE.freeTest ? 'Free water test' : 'Water test',
    text: 'We test the water at your kitchen tap. You see your hardness, chlorine and iron numbers.',
  },
  {
    title: 'Clear options',
    text: 'We show you what each system fixes and what it costs to own. You pick, with no pressure.',
  },
  {
    title: 'Clean install',
    text: 'Most installs take one visit. We set the system for your water and show you the upkeep.',
  },
];

const compare = [
  { name: 'Water softener', removes: 'Hardness minerals that cause scale', where: 'Whole house', upkeep: 'Add salt, yearly check' },
  { name: 'Whole house filter', removes: 'Chlorine, sediment, odors', where: 'Whole house', upkeep: 'Change cartridge or media' },
  { name: 'Reverse osmosis', removes: 'Most dissolved solids and sodium', where: 'One kitchen faucet', upkeep: 'Filters yearly, membrane every few years' },
];

const faqs = [
  {
    q: 'How hard is Sioux Falls water?',
    a: `Hard. The City of Sioux Falls ${SF_REPORT.year} water report lists a softener setting of ${SF_REPORT.plantGpg} grains per gallon for water from its plant and ${SF_REPORT.lewisClarkGpg} for Lewis & Clark water. Anything over about 7 grains is usually called hard.`,
  },
  {
    q: 'Why does my tap water taste like chlorine?',
    a: `The city uses chlorine to keep water safe in the pipes. Its ${SF_REPORT.year} report lists an average total chlorine level of ${SF_REPORT.chlorinePpm} parts per million, which is within the safe limit. A [whole house filter](/whole-house-water-filter) takes the taste out at every tap.`,
  },
  {
    q: 'What is the difference between a whole house filter and a softener?',
    a: 'A filter takes out things like chlorine, sediment and odors. A softener takes out the minerals that cause scale. Many Sioux Falls homes want both, so we install them together as a [combo system](/softener-and-filter-combo).',
  },
  {
    q: 'Is Sioux Falls water safe to drink?',
    a: `The city's ${SF_REPORT.year} report says no health based drinking water violations were recorded that year. Most filter and softener jobs here are about taste, scale and comfort, not safety.`,
  },
  {
    q: 'Do you install on homes with a private well?',
    a: 'Yes. Wells around Sioux Falls often need iron and smell treatment first. See [well water filter systems](/well-water-filtration).',
  },
];
---
<Layout title={title} description={description} graph={[faqNode(faqs)]}>
  <section class="overflow-hidden bg-soft">
    <div class="wrap grid items-center gap-10 pb-14 pt-10 lg:grid-cols-[1.05fr_1fr] lg:gap-16 lg:pb-24 lg:pt-16">
      <div>
        <p class="flex items-center gap-2 text-[0.95rem] font-semibold text-muted">
          <Icon name="pin" class="h-4 w-4 text-brand" /> Sioux Falls, SD and the towns around it
        </p>
        <h1 class="mt-5 max-w-[13ch]">Whole House Water Filters for Sioux Falls Homes</h1>
        <p class="lede mt-6">
          Hard water and chlorine taste are the two big complaints in Sioux Falls. We test your water at your tap, then
          install the filter or softener that fixes it.
        </p>
        <div class="mt-9 flex flex-wrap gap-3">
          <CallButton track="call-hero" class="btn btn-call px-6 text-[1.05rem]" />
          <a href="/free-water-test" class="btn btn-ghost">{SITE.freeTest ? 'Book a free water test' : 'Book a water test'}</a>
        </div>
      </div>

      <div class="relative">
        <div class="relative ml-auto max-w-[30rem] overflow-hidden rounded-[1.75rem] lg:max-w-none">
          <Photo photo="tap" ratio={0.84} eager sizes="(min-width: 1024px) 34rem, 92vw" widths={[480, 720, 960, 1200]} class="aspect-[0.84] max-h-[38rem]" />
        </div>
        <aside
          class="relative z-10 mx-4 -mt-24 rounded-2xl bg-white p-5 shadow-[0_30px_60px_-28px_rgba(15,30,46,0.55)] ring-1 ring-line sm:mx-auto sm:max-w-sm lg:absolute lg:-bottom-12 lg:-left-14 lg:mx-0 lg:mt-0 lg:w-[21rem]"
          aria-labelledby="water-card"
        >
          <h2 id="water-card" class="text-base font-bold tracking-normal">Sioux Falls city water</h2>
          <p class="text-sm text-muted">Numbers from the city's {SF_REPORT.year} water report</p>
          <dl class="mt-4 space-y-4">
            {
              readings.map((reading) => (
                <div>
                  <div class="flex items-baseline justify-between gap-3">
                    <dt class="text-sm font-semibold text-text">{reading.label}</dt>
                    <dd class="text-xl font-extrabold text-ink">
                      {reading.value}
                      <span class="text-sm font-semibold text-muted"> {reading.unit}</span>
                    </dd>
                  </div>
                  <div class="relative mt-2 h-2 rounded-full bg-tint" aria-hidden="true">
                    <span class="absolute inset-y-0 left-0 rounded-full bg-brand" style={`width:${pct(reading.value)}`} />
                    <span class="absolute -inset-y-1 w-0.5 rounded bg-accent" style={`left:${pct(hardAt)}`} />
                  </div>
                </div>
              ))
            }
            <div class="flex items-baseline justify-between gap-3 border-t border-line pt-3">
              <dt class="text-sm font-semibold text-text">Average chlorine</dt>
              <dd class="text-xl font-extrabold text-ink">{SF_REPORT.chlorinePpm}<span class="text-sm font-semibold text-muted"> ppm</span></dd>
            </div>
          </dl>
          <p class="mt-3 flex items-center gap-2 text-xs text-muted">
            <span class="inline-block h-3 w-0.5 rounded bg-accent" aria-hidden="true"></span>
            Water over about {hardAt} grains per gallon (gpg) is usually called hard.
          </p>
          <p class="mt-2 text-xs text-muted">
            Source: <a class="underline underline-offset-2 hover:text-brand" href={SF_REPORT.url} rel="noopener">{SF_REPORT.name}</a>
          </p>
        </aside>
      </div>
    </div>
  </section>

  <section class="border-b border-line bg-white" aria-label="Why homeowners call us">
    <ul class="wrap grid gap-x-8 gap-y-6 py-9 sm:grid-cols-2 lg:grid-cols-4">
      {
        trust.map((item) => (
          <li class="flex gap-3.5">
            <span class="grid h-11 w-11 shrink-0 place-items-center rounded-xl bg-tint text-brand">
              <Icon name={item.icon} class="h-5 w-5" />
            </span>
            <span>
              <span class="block font-bold leading-snug text-ink">{item.title}</span>
              <span class="block text-[0.95rem] text-muted">{item.text}</span>
            </span>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="band bg-white" aria-labelledby="problem-heading">
    <div class="wrap grid gap-10 lg:grid-cols-[0.8fr_1.2fr] lg:gap-16">
      <div>
        <h2 id="problem-heading">What is bugging you about your water?</h2>
        <p class="lede mt-5">Pick the one that sounds like your house. Each one opens the fix that usually works.</p>
        <p class="mt-6">
          <a class="link" href="/free-water-test">Not sure? Start with a water test</a>
        </p>
      </div>
      <ul class="divide-y divide-line overflow-hidden rounded-2xl border border-line">
        {
          problems.map((item) => (
            <li>
              <a href={item.href} class="group flex items-center gap-4 px-5 py-4 no-underline transition-colors hover:bg-soft sm:px-6">
                <span class="grid h-10 w-10 shrink-0 place-items-center rounded-lg bg-tint text-brand">
                  <Icon name={item.icon} class="h-5 w-5" />
                </span>
                <span class="min-w-0 flex-1">
                  <span class="block font-bold leading-snug text-ink">{item.problem}</span>
                  <span class="block text-[0.95rem] text-muted">Usual fix: {item.fix}</span>
                </span>
                <svg class="h-5 w-5 shrink-0 text-muted transition group-hover:translate-x-0.5 group-hover:text-brand" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M7.5 4.5 13 10l-5.5 5.5" stroke-linecap="round" stroke-linejoin="round" /></svg>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="band bg-soft" aria-labelledby="systems-heading">
    <div class="wrap">
      <h2 id="systems-heading" class="max-w-2xl">Systems we install and service</h2>
      <p class="lede mt-5">Filters, softeners and drinking water systems for city water, rural water and private wells.</p>
      <div class="mt-12 grid gap-6 lg:grid-cols-[1.1fr_1fr]">
        <a href={`/${lead.slug}`} class="group relative isolate flex min-h-[26rem] flex-col justify-end overflow-hidden rounded-[1.5rem] p-7 no-underline md:p-9">
          <Photo photo="home" ratio={1.2} sizes="(min-width: 1024px) 36rem, 92vw" class="absolute inset-0 -z-10 h-full transition duration-500 group-hover:scale-[1.03]" alt="" />
          <span class="absolute inset-0 -z-10 bg-gradient-to-t from-ink/90 via-ink/45 to-ink/0" aria-hidden="true"></span>
          <span class="text-[0.95rem] font-semibold text-white/85">Filtered water at every tap</span>
          <span class="mt-1 block text-3xl font-extrabold tracking-tight text-white">{lead.name}</span>
          <span class="mt-2 block max-w-md text-white/85">{lead.card}</span>
          <span class="mt-5 inline-flex items-center gap-2 font-bold text-white">
            See how it works
            <svg class="h-5 w-5 transition group-hover:translate-x-0.5" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M7.5 4.5 13 10l-5.5 5.5" stroke-linecap="round" stroke-linejoin="round" /></svg>
          </span>
        </a>
        <ul class="grid gap-3">
          {
            rest.map((service) => (
              <li>
                <a
                  href={`/${service.slug}`}
                  class:list={[
                    'group flex items-center gap-4 rounded-xl px-5 py-4 no-underline ring-1 transition',
                    service === featured ? 'bg-accent-soft ring-accent/25 hover:ring-accent' : 'bg-white ring-line hover:ring-brand',
                  ]}
                >
                  <span class:list={['grid h-10 w-10 shrink-0 place-items-center rounded-lg', service === featured ? 'bg-white text-accent' : 'bg-tint text-brand']}>
                    <Icon name={service.icon} class="h-5 w-5" />
                  </span>
                  <span class="min-w-0 flex-1">
                    <span class="block font-bold text-ink">{service.name}</span>
                    <span class="block text-[0.93rem] leading-snug text-muted">{service.card}</span>
                  </span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <section class="band bg-white" aria-labelledby="how-heading">
    <div class="wrap grid items-center gap-12 lg:grid-cols-2 lg:gap-20">
      <div class="overflow-hidden rounded-[1.5rem]">
        <Photo photo="tech" ratio={0.95} sizes="(min-width: 1024px) 34rem, 92vw" class="aspect-[0.95]" />
      </div>
      <div>
        <h2 id="how-heading">Test, choose, install</h2>
        <p class="lede mt-5">Three steps, and you know the price before any work starts.</p>
        <ol class="mt-10 space-y-8">
          {
            steps.map((step, index) => (
              <li class="relative flex gap-5">
                <span class="grid h-11 w-11 shrink-0 place-items-center rounded-full bg-brand text-lg font-extrabold text-white">{index + 1}</span>
                <span>
                  <h3>{step.title}</h3>
                  <p class="mt-1.5 text-muted">{step.text}</p>
                </span>
              </li>
            ))
          }
        </ol>
        <div class="mt-10 flex flex-wrap gap-3">
          <CallButton track="call-steps" />
          <a class="btn btn-ghost" href="/softener-size-calculator">Softener size calculator</a>
        </div>
      </div>
    </div>
  </section>

  <section class="band bg-soft" aria-labelledby="compare-heading">
    <div class="wrap">
      <h2 id="compare-heading">Softener, filter or reverse osmosis?</h2>
      <p class="lede mt-5">They do different jobs. Many Sioux Falls homes end up with two of the three.</p>
      <ul class="mt-10 grid gap-4 md:hidden">
        {
          compare.map((row) => (
            <li class="card">
              <h3>{row.name}</h3>
              <dl class="mt-3 grid gap-2 text-[0.95rem]">
                <div><dt class="font-semibold text-ink">Takes out</dt><dd class="text-muted">{row.removes}</dd></div>
                <div><dt class="font-semibold text-ink">Works on</dt><dd class="text-muted">{row.where}</dd></div>
                <div><dt class="font-semibold text-ink">Upkeep</dt><dd class="text-muted">{row.upkeep}</dd></div>
              </dl>
            </li>
          ))
        }
      </ul>
      <div class="mt-10 hidden overflow-x-auto rounded-2xl bg-white ring-1 ring-line md:block">
        <table class="w-full min-w-[40rem] text-left text-[0.97rem]">
          <thead class="border-b border-line text-ink">
            <tr>
              <th class="px-6 py-4 font-bold" scope="col">System</th>
              <th class="px-6 py-4 font-bold" scope="col">What it takes out</th>
              <th class="px-6 py-4 font-bold" scope="col">Where it works</th>
              <th class="px-6 py-4 font-bold" scope="col">Upkeep</th>
            </tr>
          </thead>
          <tbody>
            {
              compare.map((row) => (
                <tr class="border-t border-line first:border-t-0">
                  <th class="px-6 py-5 font-bold text-ink" scope="row">{row.name}</th>
                  <td class="px-6 py-5 text-muted">{row.removes}</td>
                  <td class="px-6 py-5 text-muted">{row.where}</td>
                  <td class="px-6 py-5 text-muted">{row.upkeep}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
      <p class="mt-6">
        <a class="link" href="/softener-size-calculator">Figure out what size softener you need</a>
      </p>
    </div>
  </section>

  <section class="band bg-white" aria-labelledby="areas-heading">
    <div class="wrap grid gap-8 lg:grid-cols-[1fr_1.3fr] lg:items-center">
      <div>
        <h2 id="areas-heading">Sioux Falls and the towns around it</h2>
        <p class="lede mt-5">Each town page covers where the water comes from and what most homes there need.</p>
      </div>
      <ul class="flex flex-wrap gap-3">
        {
          towns.map((town) => (
            <li>
              <a href={`/areas/${town.slug}`} class="btn btn-ghost">
                <Icon name="pin" class="h-4 w-4 text-brand" /> {town.name}
              </a>
            </li>
          ))
        }
        <li><a href="/areas" class="btn btn-blue">All areas</a></li>
      </ul>
    </div>
  </section>

  <Faq items={faqs} heading="Sioux Falls water questions" />
  <CtaBand />
</Layout>
