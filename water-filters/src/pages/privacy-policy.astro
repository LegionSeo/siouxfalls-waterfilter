---
import Layout from '../layouts/Layout.astro';
import { SITE } from '../config/site';
---

<Layout title={`Privacy Policy | ${SITE.name}`} description={`How ${SITE.name} handles information on this website.`}>
  <section class="wrap max-w-3xl py-12 md:py-16">
    <h1>Privacy Policy</h1>
    <div class="mt-8 space-y-5 text-muted">
      <p>This website does not have a contact form and does not ask you to make an account.</p>
      <p>When you call us, your phone number and what you tell us are used to answer your question and set up service. We do not sell that information.</p>
      <p>Our web host keeps basic server logs, like the pages visited and the time, to keep the site running and secure.</p>
      <p>If we add analytics or a contact form later, we will update this page.</p>
      <p>Questions about this policy? Call {SITE.phoneDisplay}.</p>
    </div>
  </section>
</Layout>
