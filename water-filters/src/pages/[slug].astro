---
import Layout from '../layouts/Layout.astro';
import CallButton from '../components/CallButton.astro';
import CtaBand from '../components/CtaBand.astro';
import Faq from '../components/Faq.astro';
import Icon from '../components/Icon.astro';
import Inline from '../components/Inline.astro';
import Photo from '../components/Photo.astro';
import type { PhotoKey } from '../content/photos';
import { SITE } from '../config/site';
import { serviceBySlug, services } from '../content/services';
import { towns } from '../content/towns';
import { SF_REPORT } from '../content/water';
import { breadcrumbNode, faqNode, serviceNode } from '../lib/schema';

export function getStaticPaths() {
  return services.map((service) => ({ params: { slug: service.slug } }));
}

const service = serviceBySlug(Astro.params.slug)!;
const photoFor: Record<string, PhotoKey> = {
  'whole-house-water-filter': 'home',
  'water-softener-installation': 'faucet',
  'softener-and-filter-combo': 'tap',
  'reverse-osmosis-installation': 'glass',
  'well-water-filtration': 'home',
  'free-water-test': 'tap',
  'water-filter-service': 'tech',
};
const photo = photoFor[service.slug] ?? 'tap';
const related = service.related.map((slug) => serviceBySlug(slug)!).filter(Boolean);
const graph = [
  serviceNode({ name: service.name, slug: service.slug, description: service.description }),
  breadcrumbNode([
    { name: 'Home', path: '/' },
    { name: service.name, path: `/${service.slug}` },
  ]),
  faqNode(service.faqs),
];
---

<Layout title={service.title} description={service.description} graph={graph}>
  <section class="border-b border-line bg-soft">
    <div class="wrap py-10 md:py-14">
      <nav aria-label="Breadcrumb" class="text-sm text-muted">
        <a class="hover:text-brand" href="/">Home</a> <span aria-hidden="true">/</span> <span>{service.name}</span>
      </nav>
      <div class="mt-6 grid gap-10 lg:grid-cols-[1.25fr_1fr] lg:items-center lg:gap-14">
        <div>
          <h1>{service.h1}</h1>
          <p class="prose-plain mt-6 max-w-2xl text-lg text-muted"><Inline text={service.intro} /></p>
          <div class="mt-8 flex flex-wrap gap-3">
            <CallButton track={`call-${service.slug}`} class="btn btn-call px-6" />
            {service.slug !== 'free-water-test' && (
              <a href="/free-water-test" class="btn btn-ghost">{SITE.freeTest ? 'Free water test' : 'Water test'}</a>
            )}
          </div>
        </div>
        <div>
          <div class="overflow-hidden rounded-[1.5rem]">
            <Photo photo={photo} ratio={1.5} sizes="(min-width: 1024px) 30rem, 92vw" widths={[480, 720, 960]} eager class="aspect-[1.5]" />
          </div>
          <aside class="card relative z-10 mx-3 -mt-10 shadow-[0_24px_50px_-30px_rgba(15,30,46,0.5)] sm:mx-6">
            <h2 class="text-lg tracking-normal">{service.fixesHeading}</h2>
            <ul class="ticks mt-4 text-[0.97rem]">
              {service.fixes.map((item) => <li>{item}</li>)}
            </ul>
          </aside>
        </div>
      </div>
    </div>
  </section>

  <section class="band bg-white" aria-labelledby="steps-heading">
    <div class="wrap">
      <h2 id="steps-heading">{service.stepsHeading}</h2>
      <ol class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
        {
          service.steps.map((step, index) => (
            <li class="card">
              <span class="grid h-9 w-9 place-items-center rounded-full bg-brand font-extrabold text-white">{index + 1}</span>
              <h3 class="mt-4">{step.title}</h3>
              <p class="mt-2 text-[0.95rem] text-muted">{step.text}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="band bg-soft" aria-labelledby="local-heading">
    <div class="wrap grid gap-10 md:grid-cols-2">
      <div>
        <p class="kicker">Sioux Falls water</p>
        <h2 id="local-heading" class="mt-3">{service.localHeading}</h2>
        <p class="prose-plain mt-5 text-muted"><Inline text={service.local} /></p>
        <p class="mt-4 text-sm text-muted">
          Source: <a class="underline" href={SF_REPORT.url} rel="noopener">{SF_REPORT.name}</a>.
        </p>
      </div>
      <div class="card">
        <h2 class="text-2xl">{service.priceHeading}</h2>
        <ul class="ticks prose-plain mt-5 text-[0.98rem]">
          {service.price.map((item) => <li><Inline text={item} /></li>)}
        </ul>
        <p class="mt-6 text-[0.95rem] text-muted">Ask for a clear price before any work starts. We will walk you through it.</p>
      </div>
    </div>
  </section>

  <Faq items={service.faqs} heading={`${service.name} questions`} />

  <section class="band pb-0" aria-labelledby="related-heading">
    <div class="wrap">
      <h2 id="related-heading" class="text-2xl">Often paired with</h2>
      <ul class="mt-6 grid gap-4 md:grid-cols-3">
        {
          related.map((item) => (
            <li>
              <a href={`/${item.slug}`} class="card flex h-full items-start gap-4 no-underline transition hover:border-brand">
                <span class="grid h-10 w-10 shrink-0 place-items-center rounded-lg bg-tint text-brand"><Icon name={item.icon} class="h-5 w-5" /></span>
                <span>
                  <span class="block font-bold text-ink">{item.name}</span>
                  <span class="mt-1 block text-sm text-muted">{item.card}</span>
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="band" aria-labelledby="towns-heading">
    <div class="wrap">
      <h2 id="towns-heading" class="text-2xl">{service.name} near Sioux Falls</h2>
      <p class="mt-3 text-muted">We also work in these towns. Each page covers where the water comes from.</p>
      <ul class="mt-6 flex flex-wrap gap-3">
        {
          towns.map((town) => (
            <li>
              <a href={`/areas/${town.slug}`} class="btn btn-ghost">
                <Icon name="pin" class="h-4 w-4 text-brand" /> {town.name}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <CtaBand />
</Layout>
