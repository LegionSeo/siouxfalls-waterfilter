---
import Layout from '../layouts/Layout.astro';
import CallButton from '../components/CallButton.astro';
---

<Layout title="Page not found | Sioux Falls Water Filters" description="This page could not be found." noindex>
  <section class="wrap max-w-2xl py-20 text-center">
    <h1>That page is not here</h1>
    <p class="lede mx-auto mt-5">Try the home page, or call and we will help you out.</p>
    <div class="mt-8 flex flex-wrap justify-center gap-3">
      <a class="btn btn-blue" href="/">Go home</a>
      <CallButton track="call-404" />
    </div>
  </section>
</Layout>
