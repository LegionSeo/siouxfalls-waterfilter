---
import Layout from '../layouts/Layout.astro';
import CallButton from '../components/CallButton.astro';
import { SITE } from '../config/site';
import { breadcrumbNode } from '../lib/schema';
---

<Layout
  title="Contact Sioux Falls Water Filters | Book a Water Test"
  description={`Call ${SITE.name} at ${SITE.phoneDisplay} to book a water test or ask about a filter, softener or reverse osmosis system.`}
  graph={[breadcrumbNode([{ name: 'Home', path: '/' }, { name: 'Contact', path: '/contact' }])]}
>
  <section class="wrap max-w-3xl py-12 md:py-16">
    <p class="kicker">Contact</p>
    <h1 class="mt-3">Call to book a visit</h1>
    <p class="lede mt-5">{SITE.hoursLabel}. Tell us your town, whether you are on city, rural or well water, and what you are seeing.</p>
    <div class="card mt-10 text-center">
      <p class="text-muted">Call or tap to call</p>
      <p class="mt-2 font-display text-4xl font-bold text-ink md:text-5xl">{SITE.phoneDisplay}</p>
      <div class="mt-6"><CallButton track="call-contact" label="Call now" /></div>
      {SITE.phoneIsPlaceholder && <p class="mt-6 text-sm font-semibold text-sun-deep">Preview only: this phone number is a placeholder.</p>}
    </div>
    <div class="mt-10 grid gap-5 sm:grid-cols-2">
      <div class="card">
        <h2 class="text-xl">What to have ready</h2>
        <ul class="ticks mt-4 text-[0.98rem]">
          <li>Your town or address</li>
          <li>City, rural or well water</li>
          <li>The brand and age of any system you have now</li>
        </ul>
      </div>
      <div class="card">
        <h2 class="text-xl">Where we work</h2>
        <p class="mt-4 text-[0.98rem] text-muted">{SITE.serviceTowns.join(', ')}, plus {SITE.nearbyTowns.join(', ')} and nearby acreages.</p>
      </div>
    </div>
  </section>
</Layout>
