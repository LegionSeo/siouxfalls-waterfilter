---
import { SITE } from '../config/site';

interface Props {
  light?: boolean;
}

const { light = false } = Astro.props;
---

<svg class="h-9 w-9 shrink-0" viewBox="0 0 40 40" aria-hidden="true">
  <rect width="40" height="40" rx="12" fill="#1558c4" />
  <path d="M20 8s8 8.5 8 14.2A8 8 0 0 1 12 22.2C12 16.5 20 8 20 8z" fill="#fff" />
  <path d="M15.5 22.5h9M16.5 26h7" stroke="#9cc0f2" stroke-width="2.2" stroke-linecap="round" />
</svg>
<span class:list={['text-[1.1rem] font-extrabold leading-tight tracking-tight', light ? 'text-white' : 'text-ink']}>
  {SITE.name}
</span>
