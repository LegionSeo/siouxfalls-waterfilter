---
import CallButton from './CallButton.astro';
import { SITE } from '../config/site';
---

<div class="fixed inset-x-0 bottom-0 z-50 border-t border-line bg-white/95 p-3 shadow-[0_-8px_24px_-16px_rgba(15,30,46,0.35)] backdrop-blur md:hidden">
  <div class="flex gap-2">
    <CallButton track="call-sticky" label="Call now" class="btn btn-call flex-[2]" />
    <a href="/free-water-test" class="btn btn-ghost flex-1 px-3" data-track="test-sticky">{SITE.freeTest ? 'Free test' : 'Water test'}</a>
  </div>
</div>
