---
import Inline from './Inline.astro';

interface Props {
  items: { q: string; a: string }[];
  heading?: string;
}

const { items, heading = 'Common questions' } = Astro.props;
---

<section class="band border-t border-line bg-white" aria-labelledby="faq-heading">
  <div class="wrap grid gap-10 lg:grid-cols-[1fr_1.8fr] lg:gap-16">
    <div>
      <h2 id="faq-heading">{heading}</h2>
      <p class="mt-4 text-muted">Something else on your mind? <a class="link" href="/contact">Ask us</a>.</p>
    </div>
    <div>
      {
        items.map((item) => (
          <details class="faq">
            <summary>{item.q}</summary>
            <p class="prose-plain pb-5 text-muted">
              <Inline text={item.a} />
            </p>
          </details>
        ))
      }
    </div>
  </div>
</section>
