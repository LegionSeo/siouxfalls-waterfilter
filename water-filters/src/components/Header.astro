---
import { SITE } from '../config/site';
import { services } from '../content/services';
import CallButton from './CallButton.astro';
import Logo from './Logo.astro';
---

<header class="sticky top-0 z-40 border-b border-line bg-white/95 backdrop-blur">
  <div class="wrap flex h-[72px] items-center justify-between gap-4">
    <a href="/" class="flex items-center gap-2.5 no-underline" aria-label={`${SITE.name} home`}>
      <Logo />
    </a>
    <nav aria-label="Main" class="hidden items-center gap-7 whitespace-nowrap text-[0.95rem] font-semibold lg:flex">
      <details class="group relative">
        <summary class="flex cursor-pointer list-none items-center gap-1 text-ink hover:text-brand">Services <svg class="h-4 w-4 transition group-open:rotate-180" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 7.5l5 5 5-5" stroke-linecap="round" stroke-linejoin="round" /></svg></summary>
        <ul class="absolute right-0 mt-3 w-72 rounded-2xl border border-line bg-white p-2 shadow-xl">
          {
            services.map((service) => (
              <li>
                <a class="block rounded-xl px-3 py-2 text-ink hover:bg-soft" href={`/${service.slug}`}>
                  {service.name}
                </a>
              </li>
            ))
          }
        </ul>
      </details>
      <a class="text-ink hover:text-brand" href="/softener-size-calculator">Softener calculator</a>
      <a class="text-ink hover:text-brand" href="/areas">Areas</a>
      <a class="text-ink hover:text-brand" href="/about">About</a>
    </nav>
    <div class="flex items-center gap-2">
      <CallButton track="call-header" class="btn btn-call hidden whitespace-nowrap px-5 xl:inline-flex" />
      <CallButton track="call-header-short" label="Call now" class="btn btn-call hidden whitespace-nowrap px-4 sm:inline-flex xl:hidden" />
      <details class="relative lg:hidden">
        <summary class="btn btn-ghost list-none px-4" aria-label="Open menu">Menu</summary>
        <div class="absolute right-0 mt-3 w-[min(20rem,calc(100vw-2.5rem))] rounded-2xl border border-line bg-white p-3 shadow-xl">
          <ul class="text-[0.95rem] font-semibold">
            {
              services.map((service) => (
                <li>
                  <a class="block rounded-xl px-3 py-2 text-ink hover:bg-soft" href={`/${service.slug}`}>
                    {service.name}
                  </a>
                </li>
              ))
            }
            <li><a class="block rounded-xl px-3 py-2 text-ink hover:bg-soft" href="/softener-size-calculator">Softener calculator</a></li>
            <li><a class="block rounded-xl px-3 py-2 text-ink hover:bg-soft" href="/areas">Areas we serve</a></li>
            <li><a class="block rounded-xl px-3 py-2 text-ink hover:bg-soft" href="/about">About</a></li>
            <li><a class="block rounded-xl px-3 py-2 text-ink hover:bg-soft" href="/contact">Contact</a></li>
          </ul>
        </div>
      </details>
    </div>
  </div>
</header>
