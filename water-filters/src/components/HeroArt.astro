---
/**
 * Hand drawn cutaway of a home with a whole house filter, a softener and a
 * brine tank in the basement, feeding the kitchen tap and the shower upstairs.
 * Pure SVG so it stays sharp and costs no image request.
 */
---

<svg viewBox="0 0 520 430" class="h-auto w-full" role="img" aria-labelledby="hero-art-title">
  <title id="hero-art-title">Drawing of a home with a whole house filter and a water softener in the basement feeding every tap</title>
  <defs>
    <linearGradient id="ha-sky" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#e8eefc" />
      <stop offset="1" stop-color="#f7f9ff" />
    </linearGradient>
    <linearGradient id="ha-tank" x1="0" y1="0" x2="1" y2="0">
      <stop offset="0" stop-color="#1f4fd6" />
      <stop offset="1" stop-color="#173aa0" />
    </linearGradient>
  </defs>

  <rect width="520" height="430" rx="28" fill="url(#ha-sky)" />
  <circle cx="448" cy="64" r="26" fill="#f6b73c" />

  <!-- ground -->
  <rect x="0" y="384" width="520" height="46" rx="0" fill="#f2ece1" />
  <path d="M0 384h520" stroke="#e3dccf" stroke-width="2" />

  <!-- house -->
  <path d="M70 176 260 66l190 110" fill="none" stroke="#10213a" stroke-width="6" stroke-linejoin="round" stroke-linecap="round" />
  <rect x="92" y="170" width="336" height="214" fill="#fff" stroke="#10213a" stroke-width="5" />
  <rect x="92" y="284" width="336" height="100" fill="#fbf8f2" stroke="#10213a" stroke-width="5" />
  <text x="104" y="306" font-family="system-ui, sans-serif" font-size="12" font-weight="700" fill="#536077" letter-spacing="1.2">BASEMENT</text>

  <!-- water main coming in -->
  <path d="M10 352h112" stroke="#1f4fd6" stroke-width="10" stroke-linecap="round" />
  <path d="M10 352h112" stroke="#9fb6f2" stroke-width="3" stroke-dasharray="6 10" stroke-linecap="round" />

  <!-- whole house filter -->
  <rect x="122" y="314" width="40" height="62" rx="12" fill="#fff" stroke="#10213a" stroke-width="4" />
  <rect x="131" y="326" width="22" height="40" rx="6" fill="#e8eefc" />
  <path d="M135 334h14M135 342h14M135 350h14M135 358h14" stroke="#1f4fd6" stroke-width="2" stroke-linecap="round" />
  <rect x="116" y="306" width="52" height="12" rx="4" fill="#10213a" />

  <!-- pipe to softener -->
  <path d="M168 330h44" stroke="#1f4fd6" stroke-width="8" stroke-linecap="round" />

  <!-- softener resin tank -->
  <rect x="212" y="292" width="50" height="86" rx="22" fill="url(#ha-tank)" />
  <rect x="222" y="280" width="30" height="16" rx="5" fill="#10213a" />
  <path d="M226 318h22" stroke="#fff" stroke-opacity="0.5" stroke-width="3" stroke-linecap="round" />

  <!-- brine tank with salt -->
  <rect x="276" y="318" width="64" height="58" rx="8" fill="#fff" stroke="#10213a" stroke-width="4" />
  <path d="M282 348l8-6 8 6 8-6 8 6 8-6 8 6 4-3" fill="none" stroke="#f6b73c" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" />

  <!-- clean water up to the rooms -->
  <path d="M237 280v-46h150v-14" fill="none" stroke="#2bb3e6" stroke-width="8" stroke-linecap="round" stroke-linejoin="round" />
  <path d="M237 234H150v-30" fill="none" stroke="#2bb3e6" stroke-width="8" stroke-linecap="round" stroke-linejoin="round" />

  <!-- kitchen counter and tap -->
  <rect x="340" y="246" width="78" height="38" fill="#e8eefc" stroke="#10213a" stroke-width="4" />
  <path d="M387 220v-12a10 10 0 0 1 20 0v4" fill="none" stroke="#10213a" stroke-width="5" stroke-linecap="round" />
  <path d="M407 218c-3 5 0 9 0 9" fill="none" stroke="#2bb3e6" stroke-width="4" stroke-linecap="round" />
  <rect x="397" y="226" width="20" height="20" rx="3" fill="#fff" stroke="#10213a" stroke-width="3" />
  <rect x="400" y="234" width="14" height="10" fill="#9fdcf5" />

  <!-- shower -->
  <path d="M150 204v-14h-18" fill="none" stroke="#10213a" stroke-width="5" stroke-linecap="round" />
  <rect x="118" y="186" width="24" height="9" rx="4" fill="#10213a" />
  <path d="M122 202v10M130 206v12M138 202v10" stroke="#2bb3e6" stroke-width="3" stroke-linecap="round" />

  <!-- sparkle on the clean side -->
  <path d="M302 176v14M295 183h14" stroke="#f6b73c" stroke-width="3" stroke-linecap="round" />
  <path d="M190 150v10M185 155h10" stroke="#f6b73c" stroke-width="3" stroke-linecap="round" />
</svg>
