---
import { Icon } from 'astro-icon/components';
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CallButton from '../../components/CallButton.astro';
import CtaBand from '../../components/CtaBand.astro';
import Photo from '../../components/Photo.astro';
import { SITE } from '../../config/site';
import { towns } from '../../content/towns';
import { breadcrumbNode } from '../../lib/schema';
const crumbs = [{ name: 'Home', path: '/' }, { name: 'Service Area', path: '/areas' }];
---
<Layout
  title="HVAC Service Area Near Sioux Falls, SD | Sioux Falls HVAC"
  description="Furnace, AC and heat pump service in Sioux Falls and nearby towns: Brandon, Harrisburg, Tea, Hartford, Dell Rapids, Canton, Lennox and more."
  graph={[breadcrumbNode(crumbs)]}
>
  <section class="pb-12 pt-8 sm:pt-10">
    <div class="wrap">
      <Breadcrumbs items={crumbs} />
      <div class="mt-6 grid items-center gap-10 lg:grid-cols-[1.2fr_1fr]">
        <div>
          <h1 class="text-5xl sm:text-6xl">Where we work</h1>
          <p class="prose-sf mt-4 text-lg">Heating and cooling service for Sioux Falls and the towns around it in Minnehaha and Lincoln counties. Not sure if your home is covered? Call and ask.</p>
          <div class="mt-7"><CallButton class="text-lg" /></div>
        </div>
        <div class="overflow-hidden rounded-[var(--radius-md)]">
          <Photo photo="snowHouse" ratio={16 / 10} sizes="(min-width: 1024px) 480px, 100vw" eager />
        </div>
      </div>
    </div>
  </section>
  <section class="py-14 sm:py-20">
    <div class="wrap">
      <ul class="border-t border-line">
        <li class="border-b border-line">
          <a href="/" class="group grid gap-1 py-6 sm:grid-cols-[16rem_1fr] sm:gap-8">
            <span>
              <span class="block font-display text-4xl font-bold text-ink group-hover:underline group-hover:decoration-call group-hover:decoration-4 group-hover:underline-offset-4">Sioux Falls</span>
              <span class="block text-muted">Minnehaha and Lincoln counties</span>
            </span>
            <span class="text-lg text-body sm:pt-2">Furnace, AC and heat pump service across the city.</span>
          </a>
        </li>
        {towns.map((t) => (
          <li class="border-b border-line">
            <a href={`/areas/${t.slug}`} class="group grid gap-1 py-6 sm:grid-cols-[16rem_1fr] sm:gap-8">
              <span>
                <span class="block font-display text-4xl font-bold text-ink group-hover:underline group-hover:decoration-call group-hover:decoration-4 group-hover:underline-offset-4">{t.name}</span>
                <span class="block text-muted">{t.county}</span>
              </span>
              <span class="text-lg text-body sm:pt-2">{t.lead.split('. ')[0]}.</span>
            </a>
          </li>
        ))}
      </ul>
      <div class="mt-12 border-l-4 border-call pl-5">
        <h2 class="text-4xl">Also serving</h2>
        <p class="mt-2 text-lg text-body">{SITE.nearbyTowns.join(', ')}, and rural homes nearby. Call to check your address.</p>
      </div>
    </div>
  </section>
  <CtaBand />
</Layout>
