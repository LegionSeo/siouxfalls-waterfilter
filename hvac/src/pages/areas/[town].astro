---
import { Icon } from 'astro-icon/components';
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CallButton from '../../components/CallButton.astro';
import CtaBand from '../../components/CtaBand.astro';
import Faq from '../../components/Faq.astro';
import { SITE } from '../../config/site';
import { services, serviceBySlug } from '../../content/services';
import { towns, type Town } from '../../content/towns';
import { breadcrumbNode, faqNode } from '../../lib/schema';

export function getStaticPaths() {
  return towns.map((t) => ({ params: { town: t.slug }, props: { town: t } }));
}
const { town } = Astro.props as { town: Town };
const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'Service Area', path: '/areas' },
  { name: town.name, path: `/areas/${town.slug}` },
];
const featured = town.featured.map((s) => serviceBySlug(s)!);
const others = services.filter((s) => !town.featured.includes(s.slug));
const nearby = towns.filter((t) => t.slug !== town.slug);
---
<Layout title={town.title} description={town.description} graph={[faqNode(town.faqs), breadcrumbNode(crumbs)]}>
  <section class="pb-12 pt-8 sm:pt-10">
    <div class="wrap">
      <Breadcrumbs items={crumbs} />
      <div class="mt-6 grid gap-10 lg:grid-cols-[1.3fr_1fr]">
        <div>
          <p class="eyebrow">{town.county}, South Dakota</p>
          <h1 class="mt-3 text-4xl font-extrabold sm:text-5xl">{town.h1}</h1>
          <p class="prose-sf mt-5 text-lg">{town.lead}</p>
          <div class="mt-7"><CallButton class="text-lg" /></div>
        </div>
        <dl class="grid grid-cols-2 gap-px self-start overflow-hidden rounded-[var(--radius-lg)] border border-line bg-line">
          {town.facts.map((f) => (
            <div class="bg-card p-5">
              <dt class="text-xs font-bold uppercase tracking-wider text-muted">{f.label}</dt>
              <dd class="mt-1 font-display text-lg font-bold leading-snug text-ink">{f.value}</dd>
            </div>
          ))}
        </dl>
      </div>
    </div>
  </section>

  <section class="border-y border-line bg-card py-14 sm:py-16">
    <div class="wrap grid gap-12 lg:grid-cols-2">
      {town.body.map((b) => (
        <div>
          <h2 class="text-2xl font-extrabold sm:text-3xl">{b.title}</h2>
          <div class="prose-sf mt-4">{b.text.map((p) => <p>{p}</p>)}</div>
        </div>
      ))}
    </div>
  </section>

  <section class="py-14 sm:py-16" aria-labelledby="town-services">
    <div class="wrap">
      <h2 id="town-services" class="text-3xl font-extrabold">HVAC services in {town.name}</h2>
      <ul class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {featured.map((s) => (
          <li>
            <a href={`/services/${s.slug}`} class:list={['group flex h-full flex-col rounded-[var(--radius-lg)] p-6', s.group === 'cooling' ? 'bg-frost-soft' : 'bg-ember-soft']}>
              <Icon name={s.icon} class:list={['h-7 w-7', s.group === 'cooling' ? 'text-frost' : 'text-ember']} aria-hidden="true" />
              <span class="mt-4 font-display text-lg font-bold text-ink group-hover:underline">{s.name} in {town.name}</span>
              <span class="mt-1 text-[0.95rem] text-body">{s.short}</span>
            </a>
          </li>
        ))}
      </ul>
      <p class="mt-6 text-body">
        Also in {town.name}:{' '}
        {others.map((s, i) => (
          <>
            <a href={`/services/${s.slug}`} class="link">{s.name}</a>{i < others.length - 1 ? ', ' : '.'}
          </>
        ))}
      </p>
    </div>
  </section>

  <Faq items={town.faqs} title={`HVAC in ${town.name}`} />

  <section class="pb-16">
    <div class="wrap">
      <h2 class="text-xl font-extrabold">Nearby towns</h2>
      <ul class="mt-4 flex flex-wrap gap-2">
        <li><a href="/" class="inline-block rounded-full border border-ink/20 bg-card px-4 py-2 font-semibold text-ink hover:border-ink">Sioux Falls</a></li>
        {nearby.map((t) => (
          <li><a href={`/areas/${t.slug}`} class="inline-block rounded-full border border-ink/20 bg-card px-4 py-2 font-semibold text-ink hover:border-ink">{t.name}</a></li>
        ))}
      </ul>
    </div>
  </section>
  <CtaBand title={`Need heat or AC help in ${town.name}?`} />
</Layout>
