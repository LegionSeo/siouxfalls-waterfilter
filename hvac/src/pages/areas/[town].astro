---
import { Icon } from 'astro-icon/components';
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CallButton from '../../components/CallButton.astro';
import CtaBand from '../../components/CtaBand.astro';
import Faq from '../../components/Faq.astro';
import { SITE } from '../../config/site';
import { services, serviceBySlug } from '../../content/services';
import { towns, type Town } from '../../content/towns';
import { breadcrumbNode, faqNode } from '../../lib/schema';

export function getStaticPaths() {
  return towns.map((t) => ({ params: { town: t.slug }, props: { town: t } }));
}
const { town } = Astro.props as { town: Town };
const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'Service Area', path: '/areas' },
  { name: town.name, path: `/areas/${town.slug}` },
];
const featured = town.featured.map((s) => serviceBySlug(s)!);
const others = services.filter((s) => !town.featured.includes(s.slug));
const nearby = towns.filter((t) => t.slug !== town.slug);
---
<Layout title={town.title} description={town.description} graph={[faqNode(town.faqs), breadcrumbNode(crumbs)]}>
  <section class="bg-ink pb-14 pt-8 text-white sm:pb-20 sm:pt-10">
    <div class="wrap">
      <Breadcrumbs items={crumbs} dark />
      <div class="mt-8 grid gap-12 lg:grid-cols-[1.4fr_1fr] lg:gap-16">
        <div>
          <p class="text-lg font-semibold text-white/70">{town.county}, South Dakota</p>
          <h1 class="mt-2 text-5xl text-white sm:text-6xl">{town.h1}</h1>
          <p class="prose-sf mt-5 text-lg text-white/90">{town.lead}</p>
          <div class="mt-8"><CallButton class="min-h-14 px-6 font-display text-2xl" /></div>
        </div>
        <dl class="self-end border-t-4 border-call">
          {town.facts.map((f) => (
            <div class="flex items-baseline justify-between gap-6 border-b border-white/15 py-3.5">
              <dt class="text-white/70">{f.label}</dt>
              <dd class="text-right font-display text-2xl font-bold leading-tight text-white">{f.value}</dd>
            </div>
          ))}
        </dl>
      </div>
    </div>
  </section>

  <section class="py-14 sm:py-20">
    <div class="wrap grid gap-12 lg:grid-cols-2">
      {town.body.map((b) => (
        <div>
          <h2 class="text-4xl">{b.title}</h2>
          <div class="prose-sf mt-4">{b.text.map((p) => <p>{p}</p>)}</div>
        </div>
      ))}
    </div>
  </section>

  <section class="bg-paper py-14 sm:py-20" aria-labelledby="town-services">
    <div class="wrap">
      <h2 id="town-services" class="text-5xl">HVAC services in {town.name}</h2>
      <ul class="mt-10 grid gap-x-8 gap-y-6 sm:grid-cols-2 lg:grid-cols-4">
        {featured.map((s) => (
          <li class:list={[s.group === 'cooling' ? 'rule-cool' : 'rule-heat']}>
            <a href={`/services/${s.slug}`} class="group block pt-4">
              <span class="block font-display text-[1.75rem] font-bold leading-tight text-ink group-hover:underline">{s.name} in {town.name}</span>
              <span class="mt-2 block text-body">{s.short}</span>
            </a>
          </li>
        ))}
      </ul>
      <p class="mt-10 text-lg text-body">
        Also in {town.name}:{' '}
        {others.map((s, i) => (
          <>
            <a href={`/services/${s.slug}`} class="link">{s.name}</a>{i < others.length - 1 ? ', ' : '.'}
          </>
        ))}
      </p>
    </div>
  </section>

  <Faq items={town.faqs} title={`HVAC in ${town.name}`} />

  <section class="pb-16">
    <div class="wrap">
      <h2 class="text-4xl">Nearby towns</h2>
      <ul class="mt-4 flex flex-wrap gap-x-8 gap-y-2 border-t border-line pt-4">
        <li><a href="/" class="font-display text-[1.75rem] font-bold text-ink hover:underline">Sioux Falls</a></li>
        {nearby.map((t) => (
          <li><a href={`/areas/${t.slug}`} class="font-display text-[1.75rem] font-bold text-ink hover:underline">{t.name}</a></li>
        ))}
      </ul>
    </div>
  </section>
  <CtaBand title={`Need heat or AC help in ${town.name}?`} />
</Layout>
