---
import { Icon } from 'astro-icon/components';
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CallButton from '../../components/CallButton.astro';
import CtaBand from '../../components/CtaBand.astro';
import Faq from '../../components/Faq.astro';
import Photo from '../../components/Photo.astro';
import { services, serviceBySlug, type Service } from '../../content/services';
import { towns } from '../../content/towns';
import { breadcrumbNode, faqNode, serviceNode } from '../../lib/schema';

export function getStaticPaths() {
  return services.map((s) => ({ params: { slug: s.slug }, props: { service: s } }));
}

const { service } = Astro.props as { service: Service };
const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'Services', path: '/services' },
  { name: service.name, path: `/services/${service.slug}` },
];
const related = service.related.map((slug) => serviceBySlug(slug)!).filter(Boolean);
const tone = service.group === 'cooling' ? 'frost' : 'ember';
---
<Layout
  title={service.title}
  description={service.description}
  graph={[serviceNode(service), faqNode(service.faqs), breadcrumbNode(crumbs)]}
>
  <section class="pb-12 pt-8 sm:pt-10 lg:pb-16">
    <div class="wrap">
      <Breadcrumbs items={crumbs} />
      <div class="mt-6 grid items-center gap-10 lg:grid-cols-[1.1fr_1fr]">
        <div>
          <p class:list={['inline-block border-t-4 pt-2 text-lg font-semibold', tone === 'frost' ? 'border-frost text-frost' : 'border-ember text-ember']}>{service.group === 'heating' ? 'Heating' : 'Cooling'}</p>
          <h1 class="mt-3 text-5xl sm:text-6xl">{service.h1}</h1>
          <div class="prose-sf mt-5 text-lg">
            {service.intro.map((p) => <p>{p}</p>)}
          </div>
          <div class="mt-7 flex flex-wrap gap-3">
            <CallButton class="text-lg" />
          </div>
        </div>
        <div class="overflow-hidden rounded-[var(--radius-md)]">
          <Photo photo={service.photo} ratio={4 / 3} sizes="(min-width: 1024px) 520px, 100vw" eager />
        </div>
      </div>
    </div>
  </section>

  <section class="bg-paper py-14 sm:py-20" aria-labelledby="signs-title">
    <div class="wrap grid gap-8 lg:grid-cols-[1fr_1.6fr] lg:gap-16">
      <h2 id="signs-title" class="text-4xl sm:text-5xl">{service.signsTitle}</h2>
      <ul class:list={['grid gap-x-10 sm:grid-cols-2', tone === 'frost' ? 'rule-cool' : 'rule-heat']}>
        {service.signs.map((sign) => (
          <li class="border-b border-ink/15 py-4 text-lg text-ink">{sign}</li>
        ))}
      </ul>
    </div>
  </section>

  <section class="py-14 sm:py-20" aria-labelledby="steps-title">
    <div class="wrap">
      <h2 id="steps-title" class="max-w-2xl text-4xl sm:text-5xl">What happens on the visit</h2>
      <ol class="mt-10 grid gap-8 md:grid-cols-2 lg:grid-cols-4">
        {service.steps.map((step, i) => (
          <li class="border-t-2 border-ink pt-5">
            <span class="font-display text-5xl font-bold leading-none text-ink/25" aria-hidden="true">{i + 1}</span>
            <h3 class="mt-2 text-[1.75rem]">{step.title}</h3>
            <p class="mt-2 text-body">{step.text}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="border-y border-line bg-paper py-14 sm:py-20" aria-labelledby="local-title">
    <div class="wrap grid gap-10 lg:grid-cols-[1.4fr_1fr]">
      <div>
        <h2 id="local-title" class="text-4xl sm:text-5xl">{service.local.title}</h2>
        <div class="prose-sf mt-4">
          {service.local.text.map((p) => <p>{p}</p>)}
        </div>
      </div>
      <div class="border-t-4 border-ink pt-5">
        <h3 class="text-[1.75rem]">{service.name} near Sioux Falls</h3>
        <p class="mt-1 text-muted">Also available in these towns:</p>
        <ul class="mt-3">
          {towns.map((t) => (
            <li class="border-b border-ink/15"><a href={`/areas/${t.slug}`} class="block py-2.5 text-lg font-semibold text-ink hover:underline">{t.name}</a></li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <Faq items={service.faqs} title={`${service.name} questions`} />

  <section class="pb-16 sm:pb-20" aria-labelledby="related-title">
    <div class="wrap">
      <h2 id="related-title" class="text-4xl">Related services</h2>
      <ul class="mt-6 grid gap-x-10 md:grid-cols-3">
        {related.map((s) => (
          <li class:list={[s.group === 'cooling' ? 'rule-cool' : 'rule-heat']}>
            <a href={`/services/${s.slug}`} class="group block py-5">
              <span class="block font-display text-[1.75rem] font-bold leading-tight text-ink group-hover:underline">{s.name}</span>
              <span class="mt-1 block text-body">{s.short}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <CtaBand />
</Layout>
