---
import { Icon } from 'astro-icon/components';
import Layout from '../layouts/Layout.astro';
import CallButton from '../components/CallButton.astro';
import CtaBand from '../components/CtaBand.astro';
import Faq from '../components/Faq.astro';
import Photo from '../components/Photo.astro';
import RangeCard from '../components/RangeCard.astro';
import { SITE, phoneHref } from '../config/site';
import { services, groups } from '../content/services';
import { towns } from '../content/towns';
import { homeFaqs, quickChecks } from '../content/home';
import { faqNode } from '../lib/schema';

const title = 'HVAC Sioux Falls, SD | Furnace and AC Repair | Sioux Falls HVAC';
const description =
  'Sioux Falls HVAC service for furnace repair, AC repair, heat pumps, mini splits and new systems. Serving Sioux Falls, Brandon, Harrisburg, Tea and nearby towns.';
const heating = services.filter((s) => s.group === 'heating');
const cooling = services.filter((s) => s.group === 'cooling');
---
<Layout title={title} description={description} graph={[faqNode(homeFaqs)]}>
  <!-- Hero -->
  <section class="relative overflow-hidden">
    <div class="wrap grid items-center gap-10 pb-14 pt-10 sm:pt-14 lg:grid-cols-[1.05fr_1fr] lg:gap-14 lg:pb-20 lg:pt-16">
      <div>
        <p class="eyebrow">Heating and cooling in Sioux Falls, SD</p>
        <h1 class="mt-3 text-[2.6rem] font-extrabold sm:text-6xl">Sioux Falls HVAC for furnaces, AC and heat pumps</h1>
        <p class="mt-5 max-w-xl text-lg text-body">
          Furnace out in January or AC struggling in July? Call a local tech for repairs, tune ups and new systems in Sioux Falls and the towns around it.
        </p>
        <div class="mt-7 flex flex-wrap gap-3">
          <CallButton class="text-lg" />
          <a href="/services" class="btn btn-line">See services</a>
        </div>
        <ul class="mt-8 grid max-w-lg grid-cols-2 gap-x-6 gap-y-2 text-[0.95rem] font-semibold text-ink">
          <li class="flex items-center gap-2"><Icon name="ph:check-circle-fill" class="h-5 w-5 text-ember" aria-hidden="true" />Furnace and AC repair</li>
          <li class="flex items-center gap-2"><Icon name="ph:check-circle-fill" class="h-5 w-5 text-ember" aria-hidden="true" />New systems and heat pumps</li>
          <li class="flex items-center gap-2"><Icon name="ph:check-circle-fill" class="h-5 w-5 text-ember" aria-hidden="true" />Fall and spring tune ups</li>
          <li class="flex items-center gap-2"><Icon name="ph:check-circle-fill" class="h-5 w-5 text-ember" aria-hidden="true" />Mini splits for garages</li>
        </ul>
      </div>
      <div class="relative">
        <div class="overflow-hidden rounded-[var(--radius-lg)]">
          <Photo photo="heatPump" ratio={4 / 3.4} sizes="(min-width: 1024px) 540px, 100vw" eager />
        </div>
        <RangeCard class="relative -mt-16 ml-4 mr-4 sm:absolute sm:-bottom-8 sm:-left-8 sm:ml-0 sm:mr-0 sm:mt-0 sm:w-[22rem]" />
      </div>
    </div>
  </section>

  <!-- Services by season -->
  <section class="border-y border-line bg-card py-16 sm:py-20" aria-labelledby="services-title">
    <div class="wrap">
      <div class="max-w-2xl">
        <p class="eyebrow">Services</p>
        <h2 id="services-title" class="mt-2 text-3xl font-extrabold sm:text-4xl">What does your home need?</h2>
        <p class="mt-3 text-muted">Pick the problem and see what a visit covers, the warning signs and common questions.</p>
      </div>
      <div class="mt-10 grid gap-6 lg:grid-cols-2">
        {[{ key: 'heating', list: heating, tone: 'ember' }, { key: 'cooling', list: cooling, tone: 'frost' }].map((col) => (
          <div class:list={['rounded-[var(--radius-lg)] p-6 sm:p-8', col.tone === 'ember' ? 'bg-ember-soft' : 'bg-frost-soft']}>
            <div class="flex items-center gap-3">
              <span class:list={['grid h-10 w-10 place-items-center rounded-full text-white', col.tone === 'ember' ? 'bg-ember' : 'bg-frost']}>
                <Icon name={col.tone === 'ember' ? 'ph:fire-bold' : 'ph:snowflake-bold'} class="h-5 w-5" aria-hidden="true" />
              </span>
              <div>
                <h3 class="text-2xl font-extrabold">{groups[col.key as 'heating' | 'cooling'].label}</h3>
                <p class="text-sm text-muted">{groups[col.key as 'heating' | 'cooling'].note}</p>
              </div>
            </div>
            <ul class="mt-6 divide-y divide-ink/10">
              {col.list.map((s) => (
                <li>
                  <a href={`/services/${s.slug}`} class="group flex items-start gap-4 py-4">
                    <Icon name={s.icon} class:list={['mt-1 h-6 w-6 shrink-0', col.tone === 'ember' ? 'text-ember' : 'text-frost']} aria-hidden="true" />
                    <span class="flex-1">
                      <span class="block font-display text-lg font-bold text-ink group-hover:underline">{s.name}</span>
                      <span class="block text-[0.95rem] text-body">{s.short}</span>
                    </span>
                    <Icon name="ph:arrow-right-bold" class="mt-1.5 h-5 w-5 shrink-0 text-ink/40 transition-transform group-hover:translate-x-1 group-hover:text-ink" aria-hidden="true" />
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Quick checks -->
  <section class="py-16 sm:py-20" aria-labelledby="checks-title">
    <div class="wrap grid gap-10 lg:grid-cols-[1fr_1.3fr] lg:items-center">
      <div class="overflow-hidden rounded-[var(--radius-lg)]">
        <Photo photo="thermostat" ratio={1} sizes="(min-width: 1024px) 460px, 100vw" widths={[480, 720, 960]} />
      </div>
      <div>
        <p class="eyebrow">Before you call</p>
        <h2 id="checks-title" class="mt-2 text-3xl font-extrabold sm:text-4xl">Four quick checks that can save a service call</h2>
        <ol class="mt-8 space-y-6">
          {quickChecks.map((c, i) => (
            <li class="flex gap-4">
              <span class="grid h-9 w-9 shrink-0 place-items-center rounded-full border-2 border-ink font-display font-extrabold text-ink">{i + 1}</span>
              <div>
                <h3 class="font-sans text-lg font-bold tracking-normal">{c.title}</h3>
                <p class="mt-1 text-body">{c.text}</p>
              </div>
            </li>
          ))}
        </ol>
        <p class="mt-8 text-body">Still no heat or cooling? <a href={phoneHref} class="link">Call {SITE.phoneDisplay}</a> and tell us what you see.</p>
      </div>
    </div>
  </section>

  <!-- Hire right -->
  <section class="bg-ink py-16 text-white sm:py-20" aria-labelledby="hire-title">
    <div class="wrap grid gap-10 lg:grid-cols-[1.2fr_1fr] lg:items-center">
      <div>
        <p class="eyebrow !text-ember-glow">Hiring an HVAC company in Sioux Falls</p>
        <h2 id="hire-title" class="mt-2 text-3xl font-extrabold text-white sm:text-4xl">Three things to ask before anyone touches your furnace</h2>
        <dl class="mt-8 space-y-6">
          <div>
            <dt class="font-display text-xl font-bold text-white">Are you licensed by the city?</dt>
            <dd class="mt-1 text-white/80">The City of Sioux Falls requires a license for any contractor doing mechanical or HVAC work inside city limits.</dd>
          </div>
          <div>
            <dt class="font-display text-xl font-bold text-white">Will you pull the permit?</dt>
            <dd class="mt-1 text-white/80">New furnaces, AC units and other mechanical work in Sioux Falls need a permit. The installer usually handles it.</dd>
          </div>
          <div>
            <dt class="font-display text-xl font-bold text-white">What is the price before you start?</dt>
            <dd class="mt-1 text-white/80">You should know the cost of the repair or the new system before any work begins.</dd>
          </div>
        </dl>
      </div>
      <div class="overflow-hidden rounded-[var(--radius-lg)]">
        <Photo photo="snowStreet" ratio={4 / 3} sizes="(min-width: 1024px) 460px, 100vw" widths={[480, 720, 960]} />
      </div>
    </div>
  </section>

  <!-- Areas -->
  <section class="py-16 sm:py-20" aria-labelledby="areas-title">
    <div class="wrap">
      <div class="max-w-2xl">
        <p class="eyebrow">Service area</p>
        <h2 id="areas-title" class="mt-2 text-3xl font-extrabold sm:text-4xl">Sioux Falls and the towns around it</h2>
        <p class="mt-3 text-muted">Heating and cooling help across Minnehaha and Lincoln counties.</p>
      </div>
      <ul class="mt-8 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
        {towns.map((t) => (
          <li>
            <a href={`/areas/${t.slug}`} class="group flex items-center justify-between rounded-[var(--radius-md)] border border-line bg-card px-5 py-4 hover:border-ink/30">
              <span>
                <span class="block font-display text-lg font-bold text-ink">{t.name}</span>
                <span class="block text-sm text-muted">{t.county}</span>
              </span>
              <Icon name="ph:arrow-right-bold" class="h-5 w-5 text-ink/40 transition-transform group-hover:translate-x-1 group-hover:text-ink" aria-hidden="true" />
            </a>
          </li>
        ))}
        <li class="rounded-[var(--radius-md)] border border-dashed border-ink/25 px-5 py-4 text-sm text-body">
          Also {SITE.nearbyTowns.join(', ')}. <a href="/areas" class="link">See the full area</a>
        </li>
      </ul>
    </div>
  </section>

  <div class="border-t border-line"><Faq items={homeFaqs} title="Sioux Falls HVAC questions" /></div>
  <CtaBand />
</Layout>
