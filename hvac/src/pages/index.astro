---
import { Icon } from 'astro-icon/components';
import Layout from '../layouts/Layout.astro';
import CtaBand from '../components/CtaBand.astro';
import Faq from '../components/Faq.astro';
import Photo from '../components/Photo.astro';
import { SITE, phoneHref } from '../config/site';
import { services, groups } from '../content/services';
import { towns } from '../content/towns';
import { homeFaqs, quickChecks } from '../content/home';
import { faqNode } from '../lib/schema';

const title = 'HVAC Sioux Falls, SD | Furnace and AC Repair | Sioux Falls HVAC';
const description =
  'Sioux Falls HVAC service for furnace repair, AC repair, heat pumps, mini splits and new systems. Serving Sioux Falls, Brandon, Harrisburg, Tea and nearby towns.';
const columns = [
  { key: 'heating' as const, rule: 'rule-heat', list: services.filter((s) => s.group === 'heating') },
  { key: 'cooling' as const, rule: 'rule-cool', list: services.filter((s) => s.group === 'cooling') },
];
---
<Layout title={title} description={description} graph={[faqNode(homeFaqs)]}>
  <!-- Hero: a Sioux Falls winter street, the phone number front and center -->
  <section class="relative isolate overflow-hidden bg-ink text-white">
    <Photo
      photo="snowStreet"
      ratio={3 / 2}
      widths={[960, 1440, 2000]}
      sizes="100vw"
      eager
      alt=""
      class="absolute inset-0 -z-10 h-full w-full object-[60%_center]"
    />
    <div class="absolute inset-0 -z-10 bg-[rgb(11_34_56/0.8)] md:bg-[linear-gradient(90deg,rgb(11_34_56/0.94)_0%,rgb(11_34_56/0.86)_45%,rgb(11_34_56/0.35)_100%)]" aria-hidden="true"></div>
    <div class="wrap pb-16 pt-14 sm:pb-24 sm:pt-20 lg:pb-28 lg:pt-24">
      <h1 class="max-w-[11ch] text-[3.4rem] text-white sm:text-7xl lg:max-w-[15ch] lg:text-[5.75rem]">Sioux Falls HVAC for furnaces, AC and heat pumps</h1>
      <p class="mt-6 max-w-[34rem] text-xl text-white/90">
        Furnace out in January or AC struggling in July? Call a local tech for repairs, tune ups and new systems in Sioux Falls and the towns around it.
      </p>
      <div class="mt-9 flex flex-wrap items-center gap-x-8 gap-y-4">
        <a href={phoneHref} class="btn btn-call min-h-16 px-7 font-display text-[1.9rem]" data-track="call-hero">
          <Icon name="ph:phone-fill" class="h-7 w-7" aria-hidden="true" />
          <span>{SITE.phoneDisplay}</span>
        </a>
        <a href="/services" class="text-lg font-semibold text-white underline decoration-white/40 underline-offset-4 hover:decoration-white">See every service</a>
      </div>
    </div>
  </section>

  <!-- The weather fact, set as one line of type -->
  <section class="bg-night text-white" aria-label="Sioux Falls temperature records">
    <div class="wrap py-7 sm:py-8">
      <p class="font-display text-[1.7rem] font-semibold leading-tight sm:text-4xl">
        Sioux Falls has hit &minus;42&deg; and 110&deg;. Your furnace and AC have to handle both.
      </p>
      <p class="mt-2 text-sm text-white/60">Record low February 1899, record high July 1936. Source: National Weather Service.</p>
    </div>
  </section>

  <!-- Services: heating and cooling, marked by a red or blue rule -->
  <section class="py-16 sm:py-24" aria-labelledby="services-title">
    <div class="wrap">
      <div class="grid gap-4 lg:grid-cols-[1fr_1.4fr] lg:items-end">
        <h2 id="services-title" class="text-5xl sm:text-6xl">What does your home need?</h2>
        <p class="max-w-xl text-lg text-muted lg:pb-2">Pick the problem. Each page covers the warning signs, what the visit includes and common questions.</p>
      </div>
      <div class="mt-12 grid gap-12 lg:grid-cols-2 lg:gap-16">
        {columns.map((col) => (
          <div class={col.rule}>
            <div class="flex items-baseline justify-between gap-4 pt-5">
              <h3 class:list={['text-4xl', col.key === 'heating' ? 'text-ember' : 'text-frost']}>{groups[col.key].label}</h3>
              <p class="text-muted">{groups[col.key].note}</p>
            </div>
            <ul class="mt-4 border-t border-line">
              {col.list.map((s) => (
                <li class="border-b border-line">
                  <a href={`/services/${s.slug}`} class="group -mx-3 block px-3 py-5 hover:bg-paper">
                    <span class="block font-display text-[1.75rem] font-bold leading-tight text-ink group-hover:underline group-hover:decoration-2 group-hover:underline-offset-4">{s.name}</span>
                    <span class="mt-1 block text-body">{s.short}</span>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Quick checks: a real sequence, so the numbers mean something -->
  <section class="bg-paper py-16 sm:py-24" aria-labelledby="checks-title">
    <div class="wrap grid gap-12 lg:grid-cols-[1.5fr_1fr] lg:gap-16">
      <div>
        <h2 id="checks-title" class="max-w-[16ch] text-5xl sm:text-6xl">Before you call, check these four things</h2>
        <p class="mt-4 max-w-xl text-lg text-muted">They take five minutes and fix more no heat and no cooling calls than you would think.</p>
        <ol class="mt-10 grid gap-x-10 gap-y-9 sm:grid-cols-2">
          {quickChecks.map((c, i) => (
            <li class="border-t-2 border-ink pt-4">
              <span class="font-display text-5xl font-bold leading-none text-ink/25" aria-hidden="true">{i + 1}</span>
              <h3 class="mt-2 text-[1.75rem]">{c.title}</h3>
              <p class="mt-2 text-body">{c.text}</p>
            </li>
          ))}
        </ol>
        <p class="mt-10 text-lg text-body">Still no heat or cooling? <a href={phoneHref} class="link">Call {SITE.phoneDisplay}</a> and tell us what you see.</p>
      </div>
      <div class="hidden lg:block">
        <div class="sticky top-28 overflow-hidden rounded-[var(--radius-md)]">
          <Photo photo="thermostat" ratio={3 / 4} sizes="420px" widths={[480, 720, 960]} />
        </div>
      </div>
    </div>
  </section>

  <!-- Hire right: photo bleeds to the left edge -->
  <section class="bg-ink text-white" aria-labelledby="hire-title">
    <div class="grid lg:grid-cols-2">
      <div class="relative min-h-[16rem] lg:min-h-full">
        <Photo photo="heatPumpBrick" ratio={1} sizes="(min-width: 1024px) 50vw, 100vw" widths={[720, 960, 1280]} class="absolute inset-0 h-full w-full" />
      </div>
      <div class="px-5 py-16 sm:px-8 sm:py-20 lg:px-16 lg:py-24 xl:pr-[max(4rem,calc((100vw-72rem)/2+2rem))]">
        <h2 id="hire-title" class="max-w-[15ch] text-5xl text-white sm:text-6xl">Three things to ask before anyone touches your furnace</h2>
        <dl class="mt-10 space-y-8">
          <div class="border-l-4 border-call pl-5">
            <dt class="font-display text-[1.75rem] font-bold leading-tight text-white">Are you licensed by the city?</dt>
            <dd class="mt-1 text-white/80">The City of Sioux Falls requires a license for any contractor doing mechanical or HVAC work inside city limits.</dd>
          </div>
          <div class="border-l-4 border-call pl-5">
            <dt class="font-display text-[1.75rem] font-bold leading-tight text-white">Will you pull the permit?</dt>
            <dd class="mt-1 text-white/80">New furnaces, AC units and other mechanical work in Sioux Falls need a permit. The installer usually handles it.</dd>
          </div>
          <div class="border-l-4 border-call pl-5">
            <dt class="font-display text-[1.75rem] font-bold leading-tight text-white">What is the price before you start?</dt>
            <dd class="mt-1 text-white/80">You should know the cost of the repair or the new system before any work begins.</dd>
          </div>
        </dl>
      </div>
    </div>
  </section>

  <!-- Areas: town names set large, no cards -->
  <section class="py-16 sm:py-24" aria-labelledby="areas-title">
    <div class="wrap">
      <h2 id="areas-title" class="text-5xl sm:text-6xl">Sioux Falls and the towns around it</h2>
      <p class="mt-4 max-w-xl text-lg text-muted">Heating and cooling help across Minnehaha and Lincoln counties.</p>
      <ul class="mt-10 grid border-t border-line sm:grid-cols-2 lg:grid-cols-5">
        {towns.map((t) => (
          <li class="border-b border-line lg:border-b-0 lg:border-r lg:last:border-r-0">
            <a href={`/areas/${t.slug}`} class="group block py-5 lg:px-5 lg:py-7 lg:first:pl-0">
              <span class="block font-display text-4xl font-bold text-ink group-hover:underline group-hover:decoration-call group-hover:decoration-4 group-hover:underline-offset-4">{t.name}</span>
              <span class="mt-1 block text-muted">{t.county}</span>
            </a>
          </li>
        ))}
      </ul>
      <p class="mt-8 text-lg text-body">We also take calls from {SITE.nearbyTowns.slice(0, -1).join(', ')} and {SITE.nearbyTowns.at(-1)}. <a href="/areas" class="link">See the full service area</a></p>
    </div>
  </section>

  <div class="border-t border-line"><Faq items={homeFaqs} title="Sioux Falls HVAC questions" /></div>
  <CtaBand />
</Layout>
