---
import Layout from '../layouts/Layout.astro';
import CallButton from '../components/CallButton.astro';
---
<Layout title="Page not found | Sioux Falls HVAC" description="This page could not be found." noindex>
  <section class="py-24">
    <div class="wrap max-w-2xl">
      <h1 class="text-5xl sm:text-6xl">That page is not here</h1>
      <p class="mt-4 text-lg">Try the <a href="/" class="link">home page</a> or the <a href="/services" class="link">list of services</a>. Need heat or AC help now?</p>
      <div class="mt-6"><CallButton class="text-lg" /></div>
    </div>
  </section>
</Layout>
