---
import '../styles/global.css';
import CallBar from '../components/CallBar.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE, absoluteUrl, canonicalUrl } from '../config/site';
import { jsonLd, pageGraph } from '../lib/schema';

interface Props {
  title: string;
  description: string;
  graph?: unknown[];
  noindex?: boolean;
  /** Hero image to preload. */
  preload?: string;
}

const { title, description, graph = [], noindex = false } = Astro.props;
const canonical = canonicalUrl(Astro.url.pathname);
const image = absoluteUrl(SITE.ogImage);
const data = jsonLd(pageGraph({ url: canonical, name: title, description }, graph));
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <meta name="theme-color" content="#13202b" />
    <link rel="preconnect" href="https://images.unsplash.com" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${SITE.name}, heating and cooling in Sioux Falls, SD`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
    <meta name="geo.region" content="US-SD" />
    <meta name="geo.placename" content="Sioux Falls" />
    <script type="application/ld+json" set:html={data} />
  </head>
  <body class="antialiased">
    <a class="skip-link" href="#content">Skip to content</a>
    <Header />
    <main id="content">
      <slot />
    </main>
    <Footer />
    <CallBar />
  </body>
</html>
