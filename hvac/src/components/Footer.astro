---
import Logo from './Logo.astro';
import { SITE, phoneHref } from '../config/site';
import { services } from '../content/services';
import { towns } from '../content/towns';
const year = 2026;
---
<footer class="bg-[#0d1720] pb-24 text-white/75 md:pb-0">
  <div class="wrap grid gap-10 py-14 sm:grid-cols-2 lg:grid-cols-[1.3fr_1fr_1fr_1fr]">
    <div>
      <Logo dark />
      <p class="mt-4 max-w-xs text-sm">{SITE.tagline}. Furnaces, AC, heat pumps and mini splits in Sioux Falls, SD and nearby towns.</p>
      <a href={phoneHref} class="mt-5 inline-block font-display text-2xl font-extrabold text-white hover:text-ember-glow">{SITE.phoneDisplay}</a>
    </div>
    <div>
      <h2 class="font-sans text-sm font-bold uppercase tracking-wider text-white">Heating</h2>
      <ul class="mt-4 space-y-2 text-sm">
        {services.filter((s) => s.group !== 'cooling').map((s) => <li><a class="hover:text-white hover:underline" href={`/services/${s.slug}`}>{s.name}</a></li>)}
      </ul>
    </div>
    <div>
      <h2 class="font-sans text-sm font-bold uppercase tracking-wider text-white">Cooling</h2>
      <ul class="mt-4 space-y-2 text-sm">
        {services.filter((s) => s.group === 'cooling').map((s) => <li><a class="hover:text-white hover:underline" href={`/services/${s.slug}`}>{s.name}</a></li>)}
      </ul>
    </div>
    <div>
      <h2 class="font-sans text-sm font-bold uppercase tracking-wider text-white">Service area</h2>
      <ul class="mt-4 space-y-2 text-sm">
        <li><a class="hover:text-white hover:underline" href="/">Sioux Falls</a></li>
        {towns.map((t) => <li><a class="hover:text-white hover:underline" href={`/areas/${t.slug}`}>{t.name}</a></li>)}
      </ul>
    </div>
  </div>
  <div class="border-t border-white/10">
    <div class="wrap flex flex-col gap-2 py-6 text-xs sm:flex-row sm:items-center sm:justify-between">
      <p>&copy; {year} {SITE.name}. Sioux Falls, SD.</p>
      <p class="flex gap-4"><a href="/about" class="hover:text-white">About</a><a href="/contact" class="hover:text-white">Contact</a><a href="/privacy-policy" class="hover:text-white">Privacy</a></p>
    </div>
  </div>
</footer>
