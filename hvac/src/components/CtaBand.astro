---
import { Icon } from 'astro-icon/components';
import { SITE, phoneHref } from '../config/site';
interface Props { title?: string; text?: string }
const {
  title = 'No heat? No AC? Call now.',
  text = 'Talk to a local heating and cooling tech about your furnace, AC or heat pump. Serving Sioux Falls and the towns around it.',
} = Astro.props;
---
<section class="bg-call text-ink">
  <div class="wrap grid items-center gap-6 py-12 sm:py-14 md:grid-cols-[1fr_auto] md:gap-12">
    <div>
      <h2 class="text-4xl sm:text-5xl">{title}</h2>
      <p class="mt-3 max-w-xl text-ink/85">{text}</p>
    </div>
    <a href={phoneHref} class="group inline-flex items-center gap-3 font-display text-[2.6rem] font-bold leading-none text-ink sm:text-6xl" data-track="call-band">
      <Icon name="ph:phone-fill" class="h-9 w-9 shrink-0 sm:h-11 sm:w-11" aria-hidden="true" />
      <span class="underline decoration-ink/30 decoration-4 underline-offset-8 group-hover:decoration-ink">{SITE.phoneDisplay}</span>
    </a>
  </div>
</section>
