---
import CallButton from './CallButton.astro';
interface Props { title?: string; text?: string }
const {
  title = 'No heat? No AC? Call now.',
  text = 'Talk to a local heating and cooling tech about your furnace, AC or heat pump. Serving Sioux Falls and the towns around it.',
} = Astro.props;
---
<section class="bg-ink text-white">
  <div class="wrap grid items-center gap-8 py-14 sm:py-16 md:grid-cols-[1.4fr_1fr]">
    <div>
      <div class="range-bar mb-6 w-28" aria-hidden="true"></div>
      <h2 class="text-3xl font-extrabold text-white sm:text-4xl">{title}</h2>
      <p class="mt-3 max-w-xl text-white/80">{text}</p>
    </div>
    <div class="flex flex-wrap gap-3 md:justify-end">
      <CallButton class="text-lg" />
    </div>
  </div>
</section>
