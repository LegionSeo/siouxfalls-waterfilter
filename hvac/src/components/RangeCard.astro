---
/** Sioux Falls temperature records from the National Weather Service quick reference page. */
interface Props { class?: string }
const { class: className } = Astro.props;
---
<figure class:list={['rounded-[var(--radius-lg)] bg-card p-5 shadow-[var(--shadow-card)] sm:p-6', className]}>
  <figcaption class="text-sm font-semibold text-muted">Sioux Falls has seen both</figcaption>
  <div class="mt-3 flex items-end justify-between gap-4">
    <div>
      <p class="font-display text-4xl font-extrabold leading-none text-frost sm:text-5xl">&minus;42&deg;</p>
      <p class="mt-1 text-sm text-muted">Record low, 1899</p>
    </div>
    <div class="text-right">
      <p class="font-display text-4xl font-extrabold leading-none text-ember sm:text-5xl">110&deg;</p>
      <p class="mt-1 text-sm text-muted">Record high, 1936</p>
    </div>
  </div>
  <div class="range-bar mt-4" aria-hidden="true"></div>
  <p class="mt-3 text-xs text-muted">Source: National Weather Service</p>
</figure>
