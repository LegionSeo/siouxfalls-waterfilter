---
interface Props { dark?: boolean; class?: string }
const { dark = false, class: className } = Astro.props;
---
<span class:list={['inline-flex items-center gap-2.5', className]}>
  <svg width="36" height="36" viewBox="0 0 40 40" aria-hidden="true" class="shrink-0">
    <rect width="40" height="40" rx="10" fill={dark ? '#ffffff' : '#13202b'} />
    <path d="M10 26a10 10 0 0 1 10-10" stroke="#9fc9e6" stroke-width="4" fill="none" stroke-linecap="round" />
    <path d="M20 16a10 10 0 0 1 10 10" stroke="#f97352" stroke-width="4" fill="none" stroke-linecap="round" />
    <path d="M20 27l5.5-7.5" stroke={dark ? '#13202b' : '#ffffff'} stroke-width="2.6" stroke-linecap="round" />
    <circle cx="20" cy="27" r="2.6" fill={dark ? '#13202b' : '#ffffff'} />
  </svg>
  <span class:list={['font-display text-[1.2rem] font-extrabold leading-none tracking-tight', dark ? 'text-white' : 'text-ink']}>
    Sioux Falls <span class={dark ? 'text-ember-glow' : 'text-ember'}>HVAC</span>
  </span>
</span>
