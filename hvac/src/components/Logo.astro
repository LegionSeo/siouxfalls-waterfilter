---
interface Props { dark?: boolean; class?: string }
const { dark = false, class: className } = Astro.props;
---
<span class:list={['inline-flex items-center gap-2.5', className]}>
  <svg width="38" height="38" viewBox="0 0 40 40" aria-hidden="true" class="shrink-0">
    <rect width="40" height="40" rx="4" fill={dark ? '#ffc72c' : '#11304d'} />
    <path d="M9 27a11 11 0 0 1 11-11" stroke={dark ? '#155e9e' : '#9cc8ee'} stroke-width="4.5" fill="none" />
    <path d="M20 16a11 11 0 0 1 11 11" stroke={dark ? '#b42318' : '#ff8a73'} stroke-width="4.5" fill="none" />
    <path d="M20 28l6-8" stroke={dark ? '#11304d' : '#ffffff'} stroke-width="2.8" stroke-linecap="round" />
    <circle cx="20" cy="28" r="2.8" fill={dark ? '#11304d' : '#ffffff'} />
  </svg>
  <span class:list={['font-display text-[1.6rem] font-bold leading-none', dark ? 'text-white' : 'text-ink']}>Sioux Falls HVAC</span>
</span>
