---
import { Icon } from 'astro-icon/components';
import { SITE, phoneHref } from '../config/site';
---
<div class="fixed inset-x-0 bottom-0 z-40 bg-ink px-3 pt-2.5 md:hidden" style="padding-bottom: max(0.625rem, env(safe-area-inset-bottom));">
  <a href={phoneHref} class="btn btn-call min-h-14 w-full font-display text-2xl" data-track="call-sticky">
    <Icon name="ph:phone-fill" class="h-6 w-6" aria-hidden="true" />
    <span>Call {SITE.phoneDisplay}</span>
  </a>
</div>
