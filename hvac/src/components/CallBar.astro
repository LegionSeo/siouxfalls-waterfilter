---
import { Icon } from 'astro-icon/components';
import { SITE, phoneHref } from '../config/site';
---
<div class="fixed inset-x-0 bottom-0 z-40 border-t border-white/10 bg-ink px-3 py-2.5 md:hidden" style="padding-bottom: max(0.625rem, env(safe-area-inset-bottom));">
  <a href={phoneHref} class="btn btn-call w-full text-base" data-track="call-sticky">
    <Icon name="ph:phone-call-bold" class="h-5 w-5" aria-hidden="true" />
    <span>Call {SITE.phoneDisplay}</span>
  </a>
</div>
